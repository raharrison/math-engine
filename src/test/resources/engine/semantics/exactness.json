{
    "category": "Semantics: exactness",
    "description": "Which operations keep an exact rational and which fall back to a double. Every case asserts the result type, not just the value.",
    "tests": [
        {
            "id": "abs_rational_001",
            "input": "abs(-3/4)",
            "expected": "3/4",
            "expectedType": "NodeRational",
            "notes": "Abs of rational preserves rational"
        },
        {
            "id": "ceil_rational_001",
            "input": "ceil(1/3)",
            "expected": 1,
            "expectedType": "NodeRational",
            "notes": "Ceil of rational preserves rational type"
        },
        {
            "id": "ceil_rational_002",
            "input": "ceil(7/2)",
            "expected": 4,
            "expectedType": "NodeRational",
            "notes": "Ceil of rational fraction"
        },
        {
            "id": "clamp_rational_001",
            "input": "clamp(1/3, 0, 1)",
            "expected": "1/3",
            "expectedType": "NodeRational",
            "notes": "Clamp in range preserves original rational"
        },
        {
            "id": "clamp_rational_002",
            "input": "clamp(-1, 0, 1)",
            "expected": 0,
            "expectedType": "NodeRational",
            "notes": "Clamp below returns min bound"
        },
        {
            "id": "clamp_rational_003",
            "input": "clamp(5, 0, 1)",
            "expected": 1,
            "expectedType": "NodeRational",
            "notes": "Clamp above returns max bound"
        },
        {
            "id": "clamp_vector_001",
            "input": "clamp({-1, 0, 2}, 0, 1)",
            "expected": [
                0,
                0,
                1
            ],
            "expectedType": "NodeVector",
            "notes": "Clamp broadcasts over vector"
        },
        {
            "id": "compare_numeric_001",
            "input": "compare(3, 5)",
            "expected": -1,
            "expectedType": "NodeRational",
            "notes": "Compare less than"
        },
        {
            "id": "compare_numeric_002",
            "input": "compare(5, 5)",
            "expected": 0,
            "expectedType": "NodeRational",
            "notes": "Compare equal"
        },
        {
            "id": "compare_numeric_003",
            "input": "compare(7, 3)",
            "expected": 1,
            "expectedType": "NodeRational",
            "notes": "Compare greater than"
        },
        {
            "id": "compare_string_001",
            "input": "compare(\"apple\", \"banana\")",
            "expected": -1,
            "expectedType": "NodeRational",
            "notes": "String comparison via compare function"
        },
        {
            "id": "compare_string_002",
            "input": "compare(\"zebra\", \"apple\")",
            "expected": 1,
            "expectedType": "NodeRational",
            "notes": "String compare greater"
        },
        {
            "id": "compare_string_003",
            "input": "compare(\"abc\", \"abc\")",
            "expected": 0,
            "expectedType": "NodeRational",
            "notes": "String compare equal"
        },
        {
            "id": "exact_abs_double",
            "input": "abs(-2.5d)",
            "expected": 2.5,
            "expectedType": "NodeDouble",
            "notes": "An inexact argument to abs gives an inexact result"
        },
        {
            "id": "exact_abs_rational",
            "input": "abs(-5/2)",
            "expected": "5/2",
            "expectedType": "NodeRational",
            "notes": "An exact argument to abs gives an exact result"
        },
        {
            "id": "exact_ceil_double",
            "input": "ceil(2.25d)",
            "expected": 3.0,
            "expectedType": "NodeDouble",
            "notes": "An inexact argument to ceil gives an inexact result"
        },
        {
            "id": "exact_ceil_rational",
            "input": "ceil(9/4)",
            "expected": 3,
            "expectedType": "NodeRational",
            "notes": "An exact argument to ceil gives an exact result"
        },
        {
            "id": "exact_denominator",
            "input": "denominator(7/9)",
            "expected": 9,
            "expectedType": "NodeRational",
            "notes": "and so does the other half"
        },
        {
            "id": "exact_dot_product",
            "input": "{1/2, 1/3} @ {2, 3}",
            "expected": 2,
            "expectedType": "NodeRational",
            "notes": "The dot product sums exact products, so it is exact"
        },
        {
            "id": "exact_factorial",
            "input": "factorial(6)",
            "expected": 720,
            "expectedType": "NodeRational",
            "notes": "A factorial of a whole number is exact, however large"
        },
        {
            "id": "exact_first",
            "input": "first({1/2, 1/3})",
            "expected": "1/2",
            "expectedType": "NodeRational",
            "notes": "Selecting an element returns it unchanged, exactness included"
        },
        {
            "id": "exact_floor_double",
            "input": "floor(3.7d)",
            "expected": 3.0,
            "expectedType": "NodeDouble",
            "notes": "A decimal literal is exact by default, so the 'd' suffix is what makes this a double"
        },
        {
            "id": "exact_gcd",
            "input": "gcd(12, 18)",
            "expected": 6,
            "expectedType": "NodeRational",
            "notes": "Greatest common divisor is a whole number"
        },
        {
            "id": "exact_last",
            "input": "last({1/2, 1/3})",
            "expected": "1/3",
            "expectedType": "NodeRational",
            "notes": "and the same from the other end"
        },
        {
            "id": "exact_lcm",
            "input": "lcm(6, 15)",
            "expected": 30,
            "expectedType": "NodeRational",
            "notes": "So is the least common multiple"
        },
        {
            "id": "exact_matrix_product",
            "input": "[1/2, 0; 0, 1/3] @ [2, 0; 0, 3]",
            "expected": [
                [
                    1,
                    0
                ],
                [
                    0,
                    1
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "And so is a matrix product, right down to the identity"
        },
        {
            "id": "exact_max_double",
            "input": "max(0.5d, 0.25d)",
            "expected": 0.5,
            "expectedType": "NodeDouble",
            "notes": "An inexact argument to max gives an inexact result"
        },
        {
            "id": "exact_max_rational",
            "input": "max(1/2, 1/3)",
            "expected": "1/2",
            "expectedType": "NodeRational",
            "notes": "An exact argument to max gives an exact result"
        },
        {
            "id": "exact_mean_double",
            "input": "mean(0.5d, 0.25d)",
            "expected": 0.375,
            "expectedType": "NodeDouble",
            "notes": "An inexact argument to mean gives an inexact result"
        },
        {
            "id": "exact_mean_rational",
            "input": "mean(1/2, 1/4)",
            "expected": "3/8",
            "expectedType": "NodeRational",
            "notes": "An exact argument to mean gives an exact result"
        },
        {
            "id": "exact_min_double",
            "input": "min(0.5d, 0.25d)",
            "expected": 0.25,
            "expectedType": "NodeDouble",
            "notes": "An inexact argument to min gives an inexact result"
        },
        {
            "id": "exact_min_rational",
            "input": "min(1/2, 1/3)",
            "expected": "1/3",
            "expectedType": "NodeRational",
            "notes": "An exact argument to min gives an exact result"
        },
        {
            "id": "exact_modulo_double",
            "input": "3.5d mod 2",
            "expected": 1.5,
            "expectedType": "NodeDouble",
            "notes": "An inexact argument to modulo gives an inexact result"
        },
        {
            "id": "exact_modulo_rational",
            "input": "7/2 mod 2",
            "expected": "3/2",
            "expectedType": "NodeRational",
            "notes": "An exact argument to modulo gives an exact result"
        },
        {
            "id": "exact_numerator",
            "input": "numerator(7/9)",
            "expected": 7,
            "expectedType": "NodeRational",
            "notes": "Taking a rational apart gives whole numbers"
        },
        {
            "id": "exact_product_double",
            "input": "product(0.5d, 0.5d)",
            "expected": 0.25,
            "expectedType": "NodeDouble",
            "notes": "An inexact argument to product gives an inexact result"
        },
        {
            "id": "exact_product_rational",
            "input": "product(2/3, 3/4)",
            "expected": "1/2",
            "expectedType": "NodeRational",
            "notes": "An exact argument to product gives an exact result"
        },
        {
            "id": "exact_round_double",
            "input": "round(2.25d)",
            "expected": 2.0,
            "expectedType": "NodeDouble",
            "notes": "An inexact argument to round gives an inexact result"
        },
        {
            "id": "exact_round_rational",
            "input": "round(9/4)",
            "expected": 2,
            "expectedType": "NodeRational",
            "notes": "An exact argument to round gives an exact result"
        },
        {
            "id": "exact_sign_of_double",
            "input": "sign(-3.5d)",
            "expected": -1,
            "expectedType": "NodeRational",
            "notes": "The sign of an inexact value is still exactly minus one"
        },
        {
            "id": "exact_sort",
            "input": "sort({3/2, 1/2})",
            "expected": [
                "1/2",
                "3/2"
            ],
            "expectedType": "NodeVector",
            "notes": "Sorting rearranges elements without converting them"
        },
        {
            "id": "exact_sum_double",
            "input": "sum(0.5d, 0.25d)",
            "expected": 0.75,
            "expectedType": "NodeDouble",
            "notes": "An inexact argument to sum gives an inexact result"
        },
        {
            "id": "exact_sum_rational",
            "input": "sum(1/2, 1/3)",
            "expected": "5/6",
            "expectedType": "NodeRational",
            "notes": "An exact argument to sum gives an exact result"
        },
        {
            "id": "exact_trace",
            "input": "trace([1/2, 0; 0, 1/3])",
            "expected": "5/6",
            "expectedType": "NodeRational",
            "notes": "The trace of an exact matrix is exact"
        },
        {
            "id": "exact_trunc_double",
            "input": "trunc(-2.25d)",
            "expected": -2.0,
            "expectedType": "NodeDouble",
            "notes": "An inexact argument to trunc gives an inexact result"
        },
        {
            "id": "exact_trunc_rational",
            "input": "trunc(-9/4)",
            "expected": -2,
            "expectedType": "NodeRational",
            "notes": "An exact argument to trunc gives an exact result"
        },
        {
            "id": "floor_double_001",
            "input": "floor(3.7)",
            "expected": 3.0,
            "expectedType": "NodeRational",
            "notes": "Floor of double stays double"
        },
        {
            "id": "floor_rational_001",
            "input": "floor(7/2)",
            "expected": 3,
            "expectedType": "NodeRational",
            "notes": "Floor of rational preserves rational type"
        },
        {
            "id": "floor_rational_002",
            "input": "floor(1/3)",
            "expected": 0,
            "expectedType": "NodeRational",
            "notes": "Floor of small rational"
        },
        {
            "id": "floor_vector_001",
            "input": "floor({7/2, 5/3, 2.7})",
            "expected": [
                3,
                1,
                2.0
            ],
            "expectedType": "NodeVector",
            "notes": "Floor broadcasts over vector, preserving per-element types"
        },
        {
            "id": "fmod_double_001",
            "input": "fmod(5.5, 2.0)",
            "expected": 1.5,
            "expectedType": "NodeRational",
            "notes": "Double fmod stays double"
        },
        {
            "id": "fmod_rational_001",
            "input": "fmod(7, 3)",
            "expected": 1,
            "expectedType": "NodeRational",
            "notes": "Integer fmod produces rational"
        },
        {
            "id": "lerp_double_001",
            "input": "lerp(0, 10, 0.5)",
            "expected": 5.0,
            "expectedType": "NodeRational",
            "notes": "Lerp with double t stays double"
        },
        {
            "id": "lerp_rational_001",
            "input": "lerp(0, 1, 1/2)",
            "expected": "1/2",
            "expectedType": "NodeRational",
            "notes": "Lerp with rational t preserves rational"
        },
        {
            "id": "lerp_rational_002",
            "input": "lerp(0, 100, 1/4)",
            "expected": 25,
            "expectedType": "NodeRational",
            "notes": "Lerp with rational t produces integer"
        },
        {
            "id": "lerp_vector_001",
            "input": "lerp({0, 10}, {100, 200}, 1/2)",
            "expected": [
                50,
                105
            ],
            "expectedType": "NodeVector",
            "notes": "Lerp broadcasts over vectors"
        },
        {
            "id": "median_rational_even_001",
            "input": "median(1, 2, 3, 4)",
            "expected": "5/2",
            "expectedType": "NodeRational",
            "notes": "Median of even-length averages middle two as rational"
        },
        {
            "id": "median_rational_odd_001",
            "input": "median(1/4, 1/2, 3/4)",
            "expected": "1/2",
            "expectedType": "NodeRational",
            "notes": "Median of odd-length preserves middle element type"
        },
        {
            "id": "median_rational_odd_002",
            "input": "median(3, 1, 2)",
            "expected": 2,
            "expectedType": "NodeRational",
            "notes": "Median of integers preserves rational"
        },
        {
            "id": "mod_double_001",
            "input": "7.5 mod 2.0",
            "expected": 1.5,
            "expectedType": "NodeRational",
            "notes": "Double mod stays double"
        },
        {
            "id": "mod_vector_001",
            "input": "{7, 10, 15} mod 3",
            "expected": [
                1,
                1,
                0
            ],
            "expectedType": "NodeVector",
            "notes": "Mod broadcasts over vector"
        },
        {
            "id": "of_vector_001",
            "input": "50% of {100, 200, 300}",
            "expected": [
                50.0,
                100.0,
                150.0
            ],
            "expectedType": "NodeVector",
            "notes": "Percent of vector broadcasts, results are double"
        },
        {
            "id": "pow_double_001",
            "input": "pow(2, 0.5)",
            "expected": 1.4142135623730951,
            "expectedType": "NodeDouble",
            "notes": "Non-integer exponent produces double"
        },
        {
            "id": "pow_rational_001",
            "input": "pow(2/3, 3)",
            "expected": "8/27",
            "expectedType": "NodeRational",
            "notes": "Rational base with integer exponent preserves rational"
        },
        {
            "id": "pow_rational_002",
            "input": "pow(1/2, 2)",
            "expected": "1/4",
            "expectedType": "NodeRational",
            "notes": "Half squared stays rational"
        },
        {
            "id": "pow_rational_003",
            "input": "pow(3, 4)",
            "expected": 81,
            "expectedType": "NodeRational",
            "notes": "Integer power stays rational"
        },
        {
            "id": "pow_vector_001",
            "input": "pow({1/2, 1/3}, 2)",
            "expected": [
                "1/4",
                "1/9"
            ],
            "expectedType": "NodeVector",
            "notes": "Power broadcasts over vector preserving rational"
        },
        {
            "id": "remainder_rational_001",
            "input": "remainder(7, 4)",
            "expected": -1,
            "expectedType": "NodeDouble",
            "notes": "Integer IEEE remainder produces rational"
        },
        {
            "id": "round_rational_001",
            "input": "round(5/3)",
            "expected": 2,
            "expectedType": "NodeRational",
            "notes": "Round of rational preserves rational type"
        },
        {
            "id": "round_rational_002",
            "input": "round(1/3)",
            "expected": 0,
            "expectedType": "NodeRational",
            "notes": "Round of small rational"
        },
        {
            "id": "trunc_rational_001",
            "input": "trunc(7/2)",
            "expected": 3,
            "expectedType": "NodeRational",
            "notes": "Trunc of rational preserves rational type"
        },
        {
            "id": "trunc_rational_002",
            "input": "trunc(-7/2)",
            "expected": -3,
            "expectedType": "NodeRational",
            "notes": "Trunc of negative rational toward zero"
        },
        {
            "id": "det_stays_exact",
            "input": "det([[1, 2], [3, 5]])",
            "expected": -1,
            "expectedType": "NodeRational",
            "notes": "The determinant used to answer -1.0000000000000004 here"
        },
        {
            "id": "inverse_stays_exact",
            "input": "inverse([[1, 2], [3, 4]]) @ [[1, 2], [3, 4]]",
            "expected": [
                [
                    1,
                    0
                ],
                [
                    0,
                    1
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "And the inverse now round-trips to exactly the identity"
        },
        {
            "id": "trace_stays_exact",
            "input": "trace([2, 0; 0, 3])",
            "expected": 5,
            "expectedType": "NodeRational",
            "notes": "Summing exact elements gives an exact total"
        }
    ]
}
