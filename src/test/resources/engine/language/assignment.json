{
    "category": "Language: assignment",
    "description": "Binding a name to a value with ':=', what the assignment itself evaluates to, and which names are legal.",
    "tests": [
        {
            "id": "assign_003",
            "input": "x := 5; x + 3",
            "expected": 8,
            "expectedType": "NodeRational",
            "notes": "Assignment and use in expression"
        },
        {
            "id": "assign_005",
            "input": "x := 5; x := x + 1; x",
            "expected": 6,
            "expectedType": "NodeRational",
            "notes": "Reassignment"
        },
        {
            "id": "assign_computed_001",
            "input": "x := 5; y := x^2; z := y + x; z",
            "expected": 30,
            "expectedType": "NodeRational",
            "notes": "Chain of computed assignments"
        },
        {
            "id": "assign_expr_001",
            "input": "x := 2 + 3",
            "expected": 5,
            "expectedType": "NodeRational",
            "notes": "Assign expression result"
        },
        {
            "id": "assign_expr_002",
            "input": "x := 10; y := x * 2; y",
            "expected": 20,
            "expectedType": "NodeRational",
            "notes": "Use variable in assignment expression"
        },
        {
            "id": "assign_matrix_001",
            "input": "m := [[1, 2], [3, 4]]; m",
            "expected": [
                [
                    1,
                    2
                ],
                [
                    3,
                    4
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Assign matrix"
        },
        {
            "id": "assign_vector_001",
            "input": "v := {1, 2, 3}; v",
            "expected": [
                1,
                2,
                3
            ],
            "expectedType": "NodeVector",
            "notes": "Assign vector"
        },
        {
            "id": "assign_vector_002",
            "input": "v := {1, 2, 3}; v[1]",
            "expected": 2,
            "expectedType": "NodeRational",
            "notes": "Access element of vector variable"
        },
        {
            "id": "assign_vector_003",
            "input": "v := {1, 2, 3}; sum(v)",
            "expected": 6,
            "expectedType": "NodeRational",
            "notes": "Function on vector variable"
        },
        {
            "id": "assignment_001",
            "input": "x := 5",
            "expected": 5,
            "expectedType": "NodeRational",
            "notes": "Simple assignment returns value"
        },
        {
            "id": "assignment_002",
            "input": "foo := 5; 1/foo",
            "expected": 0.2,
            "expectedType": "NodeRational",
            "notes": "Simple assignment and variable usage"
        },
        {
            "id": "complex_expr_001",
            "input": "a := 2; b := 3; c := 4; a*b + c",
            "expected": 10,
            "expectedType": "NodeRational",
            "notes": "Multiple variables in expression"
        },
        {
            "id": "complex_expr_002",
            "input": "r := 5; area := pi * r^2; area",
            "expected": 78.53981633974483,
            "expectedType": "NodeDouble",
            "notes": "Circle area formula"
        },
        {
            "id": "element_matrix_chain_001",
            "input": "m := [1, 2; 3, 4]; m[0][1] := 9; m",
            "expected": [
                [
                    1,
                    9
                ],
                [
                    3,
                    4
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "A chain reaches the same element as two indices in one group"
        },
        {
            "id": "element_matrix_element_001",
            "input": "m := [1, 2; 3, 4]; m[0, 1] := 9; m",
            "expected": [
                [
                    1,
                    9
                ],
                [
                    3,
                    4
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Two indices in one group address a matrix element"
        },
        {
            "id": "element_matrix_element_negative_001",
            "input": "m := [1, 2; 3, 4]; m[-1, -1] := 0; m",
            "expected": [
                [
                    1,
                    2
                ],
                [
                    3,
                    0
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Negative row and column indices count from the end"
        },
        {
            "id": "element_matrix_row_001",
            "input": "m := [1, 2; 3, 4]; m[0] := {7, 8}; m",
            "expected": [
                [
                    7,
                    8
                ],
                [
                    3,
                    4
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "A single index addresses a whole row, which keeps its width"
        },
        {
            "id": "element_nested_vector_001",
            "input": "v := {{1, 2}, {3, 4}}; v[0][1] := 9; v",
            "expected": [
                [
                    1,
                    9
                ],
                [
                    3,
                    4
                ]
            ],
            "expectedType": "NodeVector",
            "notes": "A chain of groups writes through a vector of vectors"
        },
        {
            "id": "element_nested_vector_deep_001",
            "input": "a := {{{1, 2}}}; a[0][0][1] := 7; a",
            "expected": [
                [
                    [
                        1,
                        7
                    ]
                ]
            ],
            "expectedType": "NodeVector",
            "notes": "The rule is recursive, so depth costs no extra case"
        },
        {
            "id": "element_returns_assigned_value_001",
            "input": "v := {10, 20, 30}; v[0] := 5",
            "expected": 5,
            "expectedType": "NodeRational",
            "notes": "Answers the value assigned, not the rebuilt vector, as 'x := 5' does"
        },
        {
            "id": "element_string_001",
            "input": "s := \"hello\"; s[0] := \"H\"; s",
            "expected": "Hello",
            "expectedType": "NodeString",
            "notes": "One character of a string is replaced"
        },
        {
            "id": "element_string_chain_on_character_001",
            "input": "s := \"abc\"; s[0][0] := \"Z\"; s",
            "expected": "Zbc",
            "expectedType": "NodeString",
            "notes": "'s[0]' is itself a one-character string, so indexing it again lands on the same character"
        },
        {
            "id": "element_string_from_variable_001",
            "input": "s := \"cat\"; c := \"C\"; s[0] := c; s",
            "expected": "Cat",
            "expectedType": "NodeString",
            "notes": "The right side is any expression answering a single character"
        },
        {
            "id": "element_string_in_vector_001",
            "input": "v := {\"ab\", \"cd\"}; v[0][0] := \"A\"; v",
            "expected": [
                "Ab",
                "cd"
            ],
            "expectedType": "NodeVector",
            "notes": "A chain can end in a string held in a vector"
        },
        {
            "id": "element_string_negative_001",
            "input": "s := \"hello\"; s[-1] := \"O\"; s",
            "expected": "hellO",
            "expectedType": "NodeString",
            "notes": "A negative string index counts from the end"
        },
        {
            "id": "element_string_returns_character_001",
            "input": "s := \"abc\"; s[1] := \"B\"",
            "expected": "B",
            "expectedType": "NodeString",
            "notes": "The value is the character assigned, not the whole string"
        },
        {
            "id": "element_value_keeps_its_type_001",
            "input": "v := {1, 2, 3}; v[0] := 5 m; v",
            "expected": [
                "5 meters",
                2,
                3
            ],
            "expectedType": "NodeVector",
            "notes": "The value goes in as it is, so a vector can hold a unit quantity"
        },
        {
            "id": "element_vector_001",
            "input": "v := {10, 20, 30}; v[0] := 99; v",
            "expected": [
                99,
                20,
                30
            ],
            "expectedType": "NodeVector",
            "notes": "Writing one element of a vector, which used to be a parse error"
        },
        {
            "id": "element_vector_computed_index_001",
            "input": "v := {1, 2, 3}; i := 1; v[i + 1] := 7; v",
            "expected": [
                1,
                2,
                7
            ],
            "expectedType": "NodeVector",
            "notes": "The index is an expression"
        },
        {
            "id": "element_vector_negative_001",
            "input": "v := {10, 20, 30}; v[-1] := 99; v",
            "expected": [
                10,
                20,
                99
            ],
            "expectedType": "NodeVector",
            "notes": "A negative index counts from the end, as on the read side"
        },
        {
            "id": "element_vector_reads_old_value_001",
            "input": "v := {1, 2, 3}; v[0] := v[0] + 10; v",
            "expected": [
                11,
                2,
                3
            ],
            "expectedType": "NodeVector",
            "notes": "The right side is evaluated before the rebuild, so it can read the element it replaces"
        },
        {
            "id": "element_vector_twice_001",
            "input": "v := {1, 2, 3}; v[0] := 9; v[1] := 8; v",
            "expected": [
                9,
                8,
                3
            ],
            "expectedType": "NodeVector",
            "notes": "Two writes in a session accumulate"
        },
        {
            "id": "naming_001",
            "input": "myVar := 42; myVar",
            "expected": 42,
            "expectedType": "NodeRational",
            "notes": "CamelCase variable name"
        },
        {
            "id": "naming_002",
            "input": "my_var := 42; my_var",
            "expected": 42,
            "expectedType": "NodeRational",
            "notes": "Snake case variable name"
        },
        {
            "id": "naming_003",
            "input": "x1 := 10; x2 := 20; x1 + x2",
            "expected": 30,
            "expectedType": "NodeRational",
            "notes": "Variable names with numbers"
        },
        {
            "id": "scope_001",
            "input": "x := 1; y := 2; x + y",
            "expected": 3,
            "expectedType": "NodeRational",
            "notes": "Multiple variables in scope"
        },
        {
            "id": "shadow_001",
            "input": "x := 5; x := 10; x",
            "expected": 10,
            "expectedType": "NodeRational",
            "notes": "Variable shadowing"
        }
    ]
}
