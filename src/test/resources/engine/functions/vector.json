{
    "category": "Functions: vector",
    "description": "Aggregating, generating, searching and reshaping vectors.",
    "tests": [
        {
            "id": "all_001",
            "input": "all({true, true, true})",
            "expected": true,
            "expectedType": "NodeBoolean",
            "notes": "All true values"
        },
        {
            "id": "all_002",
            "input": "all({true, false, true})",
            "expected": false,
            "expectedType": "NodeBoolean",
            "notes": "Not all true"
        },
        {
            "id": "any_001",
            "input": "any({false, false, true})",
            "expected": true,
            "expectedType": "NodeBoolean",
            "notes": "Any true value"
        },
        {
            "id": "any_002",
            "input": "any({false, false, false})",
            "expected": false,
            "expectedType": "NodeBoolean",
            "notes": "All false"
        },
        {
            "id": "builtin_math_028",
            "input": "min(1, 2, 3)",
            "expected": 1.0,
            "expectedType": "NodeRational",
            "notes": "Min of multiple arguments"
        },
        {
            "id": "builtin_math_029",
            "input": "min({3, 1, 4, 1, 5})",
            "expected": 1.0,
            "expectedType": "NodeRational",
            "notes": "Min of vector"
        },
        {
            "id": "builtin_math_030",
            "input": "max(1, 2, 3)",
            "expected": 3.0,
            "expectedType": "NodeRational",
            "notes": "Max of multiple arguments"
        },
        {
            "id": "builtin_math_031",
            "input": "max({3, 1, 4, 1, 5})",
            "expected": 5.0,
            "expectedType": "NodeRational",
            "notes": "Max of vector"
        },
        {
            "id": "builtin_vec_001",
            "input": "sum(1, 2, 3)",
            "expected": 6,
            "expectedType": "NodeRational",
            "notes": "Sum of variadic arguments"
        },
        {
            "id": "builtin_vec_002",
            "input": "sum({1, 2, 3})",
            "expected": 6,
            "expectedType": "NodeRational",
            "notes": "Sum of vector"
        },
        {
            "id": "builtin_vec_003",
            "input": "sum({})",
            "expected": 0,
            "expectedType": "NodeRational",
            "notes": "Sum of empty vector is zero"
        },
        {
            "id": "builtin_vec_004",
            "input": "sum(1..100)",
            "expected": 5050,
            "expectedType": "NodeRational",
            "notes": "Sum of range 1 to 100"
        },
        {
            "id": "builtin_vec_005",
            "input": "product(2, 3, 4)",
            "expected": 24,
            "expectedType": "NodeRational",
            "notes": "Product of variadic arguments"
        },
        {
            "id": "builtin_vec_006",
            "input": "product({1, 2, 3, 4})",
            "expected": 24,
            "expectedType": "NodeRational",
            "notes": "Product of vector"
        },
        {
            "id": "builtin_vec_007",
            "input": "product({})",
            "expected": 1,
            "expectedType": "NodeRational",
            "notes": "Product of empty vector is one"
        },
        {
            "id": "builtin_vec_008",
            "input": "mean(1, 2, 3, 4, 5)",
            "expected": 3.0,
            "expectedType": "NodeRational",
            "notes": "Mean of variadic arguments"
        },
        {
            "id": "builtin_vec_009",
            "input": "mean({10, 20, 30})",
            "expected": 20.0,
            "expectedType": "NodeRational",
            "notes": "Mean of vector"
        },
        {
            "id": "builtin_vec_010",
            "input": "length({1, 2, 3})",
            "expected": 3,
            "expectedType": "NodeRational",
            "notes": "Length of vector"
        },
        {
            "id": "builtin_vec_011",
            "input": "length({})",
            "expected": 0,
            "expectedType": "NodeRational",
            "notes": "Length of empty vector"
        },
        {
            "id": "concat_001",
            "input": "concat({1, 2}, {3, 4})",
            "expected": [
                1,
                2,
                3,
                4
            ],
            "expectedType": "NodeVector",
            "notes": "Concatenate vectors"
        },
        {
            "id": "contains_001",
            "input": "contains({1, 2, 3}, 2)",
            "expected": true,
            "expectedType": "NodeBoolean",
            "notes": "Vector contains element"
        },
        {
            "id": "contains_002",
            "input": "contains({1, 2, 3}, 5)",
            "expected": false,
            "expectedType": "NodeBoolean",
            "notes": "Vector does not contain element"
        },
        {
            "id": "count_001",
            "input": "count({1, 2, 2, 3, 2}, 2)",
            "expected": 3,
            "expectedType": "NodeRational",
            "notes": "Count occurrences of 2"
        },
        {
            "id": "drop_001",
            "input": "drop({1, 2, 3, 4, 5}, 2)",
            "expected": [
                3,
                4,
                5
            ],
            "expectedType": "NodeVector",
            "notes": "Drop first 2 elements"
        },
        {
            "id": "fill_001",
            "input": "fill(0, 5)",
            "expected": [
                0,
                0,
                0,
                0,
                0
            ],
            "expectedType": "NodeVector",
            "notes": "Fill with zeros"
        },
        {
            "id": "first_001",
            "input": "first({10, 20, 30})",
            "expected": 10,
            "expectedType": "NodeRational",
            "notes": "First element of vector"
        },
        {
            "id": "flatten_001",
            "input": "flatten({{1, 2}, {3, 4}})",
            "expected": [
                1,
                2,
                3,
                4
            ],
            "expectedType": "NodeVector",
            "notes": "Flatten nested vectors"
        },
        {
            "id": "get_001",
            "input": "get({10, 20, 30}, 1)",
            "expected": 20,
            "expectedType": "NodeRational",
            "notes": "Get element at index"
        },
        {
            "id": "indexof_001",
            "input": "indexof({10, 20, 30}, 20)",
            "expected": 1,
            "expectedType": "NodeRational",
            "notes": "Find index of element"
        },
        {
            "id": "last_001",
            "input": "last({10, 20, 30})",
            "expected": 30,
            "expectedType": "NodeRational",
            "notes": "Last element of vector"
        },
        {
            "id": "length_003",
            "input": "len({1, 2, 3, 4, 5})",
            "expected": 5,
            "expectedType": "NodeRational",
            "notes": "len alias for length"
        },
        {
            "id": "linspace_001",
            "input": "linspace(0, 10, 5)",
            "expected": [
                0.0,
                2.5,
                5.0,
                7.5,
                10.0
            ],
            "expectedType": "NodeVector",
            "notes": "Linearly spaced values"
        },
        {
            "id": "max_003",
            "input": "max(-5, 0, 5)",
            "expected": 5.0,
            "expectedType": "NodeRational",
            "notes": "Max with negative"
        },
        {
            "id": "max_004",
            "input": "max(3, 5)",
            "expected": 5.0,
            "expectedType": "NodeRational",
            "notes": "Max of two values"
        },
        {
            "id": "mean_003",
            "input": "mean({42})",
            "expected": 42.0,
            "expectedType": "NodeRational",
            "notes": "Mean of single element"
        },
        {
            "id": "min_003",
            "input": "min(-5, 0, 5)",
            "expected": -5.0,
            "expectedType": "NodeRational",
            "notes": "Min with negative"
        },
        {
            "id": "min_004",
            "input": "min(5, 3)",
            "expected": 3.0,
            "expectedType": "NodeRational",
            "notes": "Min of two values"
        },
        {
            "id": "none_001",
            "input": "none({false, false, false})",
            "expected": true,
            "expectedType": "NodeBoolean",
            "notes": "None true"
        },
        {
            "id": "product_004",
            "input": "product({2, 0, 5})",
            "expected": 0,
            "expectedType": "NodeRational",
            "notes": "Product with zero"
        },
        {
            "id": "repeat_001",
            "input": "repeat(5, 3)",
            "expected": [
                5,
                5,
                5
            ],
            "expectedType": "NodeVector",
            "notes": "Repeat value 3 times"
        },
        {
            "id": "reverse_001",
            "input": "reverse({1, 2, 3})",
            "expected": [
                3,
                2,
                1
            ],
            "expectedType": "NodeVector",
            "notes": "Reverse vector"
        },
        {
            "id": "reverse_002",
            "input": "reverse({})",
            "expected": [],
            "expectedType": "NodeVector",
            "notes": "Reverse empty vector"
        },
        {
            "id": "reverse_003",
            "input": "reverse({42})",
            "expected": [
                42
            ],
            "expectedType": "NodeVector",
            "notes": "Reverse single element"
        },
        {
            "id": "seq_001",
            "input": "seq(1, 5)",
            "expected": [
                1,
                2,
                3,
                4,
                5
            ],
            "expectedType": "NodeVector",
            "notes": "Generate sequence 1 to 5"
        },
        {
            "id": "slice_001",
            "input": "slice({1, 2, 3, 4, 5}, 1, 4)",
            "expected": [
                2,
                3,
                4
            ],
            "expectedType": "NodeVector",
            "notes": "Slice from 1 to 4"
        },
        {
            "id": "sort_001",
            "input": "sort({3, 1, 4, 1, 5})",
            "expected": [
                1,
                1,
                3,
                4,
                5
            ],
            "expectedType": "NodeVector",
            "notes": "Sort ascending"
        },
        {
            "id": "sort_002",
            "input": "sort({})",
            "expected": [],
            "expectedType": "NodeVector",
            "notes": "Sort empty vector"
        },
        {
            "id": "sort_003",
            "input": "sort({5, 4, 3, 2, 1})",
            "expected": [
                1,
                2,
                3,
                4,
                5
            ],
            "expectedType": "NodeVector",
            "notes": "Sort reverse ordered"
        },
        {
            "id": "sum_005",
            "input": "sum({-1, 0, 1})",
            "expected": 0,
            "expectedType": "NodeRational",
            "notes": "Sum with negative numbers"
        },
        {
            "id": "take_001",
            "input": "take({1, 2, 3, 4, 5}, 3)",
            "expected": [
                1,
                2,
                3
            ],
            "expectedType": "NodeVector",
            "notes": "Take first 3 elements"
        },
        {
            "id": "unique_001",
            "input": "unique({1, 2, 2, 3, 3, 3})",
            "expected": [
                1,
                2,
                3
            ],
            "expectedType": "NodeVector",
            "notes": "Remove duplicates"
        },
        {
            "id": "vector_func_001",
            "input": "sqrt({4, 9, 16})",
            "expected": [
                2,
                3,
                4
            ],
            "expectedType": "NodeVector",
            "notes": "Function on vector"
        },
        {
            "id": "vector_func_002",
            "input": "abs({-1, -2, 3})",
            "expected": [
                1,
                2,
                3
            ],
            "expectedType": "NodeVector",
            "notes": "Abs on vector"
        },
        {
            "id": "vector_func_003",
            "input": "sin({0, pi/2, pi})",
            "expected": [
                0,
                1,
                0
            ],
            "expectedType": "NodeVector",
            "notes": "Sin on vector"
        },
        {
            "id": "zip_001",
            "input": "zip({1, 2}, {3, 4})",
            "expected": [
                [
                    1,
                    3
                ],
                [
                    2,
                    4
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "zip pairs elements positionally, giving one row per position"
        },
        {
            "id": "zip_002",
            "input": "zip({1, 2}, {3, 4}, {5, 6})",
            "expected": [
                [
                    1,
                    3,
                    5
                ],
                [
                    2,
                    4,
                    6
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "zip is variadic, so three vectors give three columns"
        },
        {
            "id": "zip_003",
            "input": "rows(zip({1, 2, 3}, {4, 5, 6}))",
            "expected": 3,
            "expectedType": "NodeRational",
            "notes": "The result has one row per element of the inputs"
        },
        {
            "id": "len_of_empty_string",
            "input": "len(\"\")",
            "expected": 0,
            "expectedType": "NodeRational",
            "notes": "The empty string has length zero"
        },
        {
            "id": "len_of_string",
            "input": "len(\"hello\")",
            "expected": 5,
            "expectedType": "NodeRational",
            "notes": "A five-letter word has length five; text was once read as a one-element sequence and answered 1"
        },
        {
            "id": "min_strings",
            "input": "min({\"b\", \"a\"})",
            "expected": "a",
            "expectedType": "NodeString",
            "notes": "Everything built on ordering works once ordering exists"
        },
        {
            "id": "max_strings",
            "input": "max({\"b\", \"a\"})",
            "expected": "b",
            "expectedType": "NodeString",
            "notes": "The same for the other end of the order"
        },
        {
            "id": "sort_strings",
            "input": "sort({\"b\", \"a\", \"c\"})",
            "expected": [
                "a",
                "b",
                "c"
            ],
            "expectedType": "NodeVector",
            "notes": "Strings sort lexicographically, where sorting them once escaped a raw JDK exception"
        },
        {
            "id": "reverse_string",
            "input": "reverse(\"abc\")",
            "expected": "cba",
            "expectedType": "NodeString",
            "notes": "Reversing text gives text, not a type error"
        },
        {
            "id": "sort_with_a_comparator",
            "input": "sort({3, 1, 2}, (a, b) -> b - a)",
            "expected": [
                3,
                2,
                1
            ],
            "expectedType": "NodeVector",
            "notes": "A comparator returns a negative, zero or positive number, as compare does; this used to be an arity error"
        },
        {
            "id": "sort_with_a_comparator_that_ties_everything",
            "input": "sort({3, 1, 2}, (a, b) -> 0)",
            "expected": [
                3,
                1,
                2
            ],
            "expectedType": "NodeVector",
            "notes": "A comparator calling everything equal leaves the order alone"
        },
        {
            "id": "sort_comparator_must_take_two",
            "input": "sort({3, 1, 2}, x -> x)",
            "expectError": true,
            "expectedErrorType": "TypeError",
            "notes": "A comparator compares two elements, so a one-parameter function is refused"
        },
        {
            "id": "count_with_a_predicate",
            "input": "count({1, 2, 3, 4}, x -> x > 2)",
            "expected": 2,
            "expectedType": "NodeRational",
            "notes": "A function in place of the value counts the elements it accepts"
        },
        {
            "id": "count_matches_across_unit_scales",
            "input": "count({1 m, 100 cm}, 1 m)",
            "expected": 2,
            "expectedType": "NodeRational",
            "notes": "Counting compares by value, as indexof and contains do; it used to compare raw magnitudes and answer 1"
        },
        {
            "id": "indexof_with_a_predicate",
            "input": "indexof({1, 2, 3}, x -> x > 1)",
            "expected": 1,
            "expectedType": "NodeRational",
            "notes": "The first position the predicate accepts"
        },
        {
            "id": "indexof_with_a_predicate_that_never_matches",
            "input": "indexof({1, 2}, x -> x > 9)",
            "expected": -1,
            "expectedType": "NodeRational",
            "notes": "Absent is -1, the same answer the value form gives"
        },
        {
            "id": "contains_with_a_predicate",
            "input": "contains({1, 2, 3}, x -> x > 2)",
            "expected": true,
            "expectedType": "NodeBoolean",
            "notes": "True when any element is accepted"
        },
        {
            "id": "unique_with_a_key",
            "input": "unique({1, 2, 3, 4}, x -> x mod 2)",
            "expected": [
                1,
                2
            ],
            "expectedType": "NodeVector",
            "notes": "The key decides what counts as a duplicate, and the first element of each group is kept"
        },
        {
            "id": "first_with_a_predicate",
            "input": "first({1, 2, 3}, x -> x > 1)",
            "expected": 2,
            "expectedType": "NodeRational",
            "notes": "The first element the predicate accepts"
        },
        {
            "id": "last_with_a_predicate",
            "input": "last({1, 2, 3}, x -> x < 3)",
            "expected": 2,
            "expectedType": "NodeRational",
            "notes": "The last element the predicate accepts"
        },
        {
            "id": "first_with_a_predicate_that_never_matches",
            "input": "first({1, 2}, x -> x > 9)",
            "expectError": true,
            "expectedErrorType": "TypeError",
            "notes": "No element matches, which is as much an error as an empty vector is"
        }
    ]
}
