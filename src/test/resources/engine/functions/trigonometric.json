{
    "category": "Functions: trigonometric",
    "description": "Circular functions and their inverses, in the default angle unit.",
    "tests": [
        {
            "id": "acos_001",
            "input": "acos(1)",
            "expected": 0.0,
            "expectedType": "NodeDouble",
            "notes": "acos(1) = 0"
        },
        {
            "id": "acos_002",
            "input": "acos(0)",
            "expected": 1.5707963267948966,
            "expectedType": "NodeDouble",
            "notes": "acos(0) = pi/2"
        },
        {
            "id": "acos_003",
            "input": "acos(-1)",
            "expected": 3.141592653589793,
            "expectedType": "NodeDouble",
            "notes": "acos(-1) = pi"
        },
        {
            "id": "acos_004",
            "input": "acos(0.5)",
            "expected": 1.0471975511965979,
            "expectedType": "NodeDouble",
            "notes": "acos(0.5) = pi/3"
        },
        {
            "id": "asin_001",
            "input": "asin(0)",
            "expected": 0.0,
            "expectedType": "NodeDouble",
            "notes": "asin(0) = 0"
        },
        {
            "id": "asin_002",
            "input": "asin(1)",
            "expected": 1.5707963267948966,
            "expectedType": "NodeDouble",
            "notes": "asin(1) = pi/2"
        },
        {
            "id": "asin_003",
            "input": "asin(-1)",
            "expected": -1.5707963267948966,
            "expectedType": "NodeDouble",
            "notes": "asin(-1) = -pi/2"
        },
        {
            "id": "asin_004",
            "input": "asin(0.5)",
            "expected": 0.5235987755982989,
            "expectedType": "NodeDouble",
            "notes": "asin(0.5) = pi/6"
        },
        {
            "id": "atan2_001",
            "input": "atan2(1, 1)",
            "expected": 0.7853981633974483,
            "expectedType": "NodeDouble",
            "notes": "atan2(1, 1) = pi/4"
        },
        {
            "id": "atan2_002",
            "input": "atan2(0, 1)",
            "expected": 0.0,
            "expectedType": "NodeDouble",
            "notes": "atan2(0, 1) = 0"
        },
        {
            "id": "atan2_003",
            "input": "atan2(1, 0)",
            "expected": 1.5707963267948966,
            "expectedType": "NodeDouble",
            "notes": "atan2(1, 0) = pi/2"
        },
        {
            "id": "atan_001",
            "input": "atan(0)",
            "expected": 0.0,
            "expectedType": "NodeDouble",
            "notes": "atan(0) = 0"
        },
        {
            "id": "atan_002",
            "input": "atan(1)",
            "expected": 0.7853981633974483,
            "expectedType": "NodeDouble",
            "notes": "atan(1) = pi/4"
        },
        {
            "id": "atan_003",
            "input": "atan(-1)",
            "expected": -0.7853981633974483,
            "expectedType": "NodeDouble",
            "notes": "atan(-1) = -pi/4"
        },
        {
            "id": "builtin_math_001",
            "input": "sin(0)",
            "expected": 0.0,
            "expectedType": "NodeDouble",
            "notes": "sin function in radians"
        },
        {
            "id": "builtin_math_002",
            "input": "cos(0)",
            "expected": 1.0,
            "expectedType": "NodeDouble",
            "notes": "cos function in radians"
        },
        {
            "id": "builtin_math_003",
            "input": "tan(0)",
            "expected": 0.0,
            "expectedType": "NodeDouble",
            "notes": "tan function in radians"
        },
        {
            "id": "cos_002",
            "input": "cos(pi/2)",
            "expected": 0.0,
            "expectedType": "NodeDouble",
            "notes": "cos(pi/2) = 0"
        },
        {
            "id": "cos_003",
            "input": "cos(pi)",
            "expected": -1.0,
            "expectedType": "NodeDouble",
            "notes": "cos(pi) = -1"
        },
        {
            "id": "cos_004",
            "input": "cos(2*pi)",
            "expected": 1.0,
            "expectedType": "NodeDouble",
            "notes": "cos(2pi) = 1 (periodicity)"
        },
        {
            "id": "cot_001",
            "input": "cot(pi/4)",
            "expected": 1.0,
            "expectedType": "NodeDouble",
            "notes": "cot(pi/4) = 1/tan(pi/4) = 1"
        },
        {
            "id": "csc_001",
            "input": "csc(pi/2)",
            "expected": 1.0,
            "expectedType": "NodeDouble",
            "notes": "csc(pi/2) = 1/sin(pi/2) = 1"
        },
        {
            "id": "identity_001_trigonometric",
            "input": "sin(pi/4) + cos(pi/4)",
            "expected": 1.4142135623730951,
            "expectedType": "NodeDouble",
            "notes": "sin(pi/4) + cos(pi/4) = sqrt(2)"
        },
        {
            "id": "identity_002_trigonometric",
            "input": "sin(0)^2 + cos(0)^2",
            "expected": 1.0,
            "expectedType": "NodeDouble",
            "notes": "Pythagorean identity at 0"
        },
        {
            "id": "identity_003_trigonometric",
            "input": "sin(pi/6)^2 + cos(pi/6)^2",
            "expected": 1.0,
            "expectedType": "NodeDouble",
            "notes": "Pythagorean identity at pi/6"
        },
        {
            "id": "sec_001",
            "input": "sec(0)",
            "expected": 1.0,
            "expectedType": "NodeDouble",
            "notes": "sec(0) = 1/cos(0) = 1"
        },
        {
            "id": "sin_003",
            "input": "sin(pi)",
            "expected": 0.0,
            "expectedType": "NodeDouble",
            "notes": "sin(pi) = 0"
        },
        {
            "id": "sin_004",
            "input": "sin(3*pi/2)",
            "expected": -1.0,
            "expectedType": "NodeDouble",
            "notes": "sin(3pi/2) = -1"
        },
        {
            "id": "sin_005",
            "input": "sin(2*pi)",
            "expected": 0.0,
            "expectedType": "NodeDouble",
            "notes": "sin(2pi) = 0 (periodicity)"
        },
        {
            "id": "sin_006",
            "input": "sin(-pi/2)",
            "expected": -1.0,
            "expectedType": "NodeDouble",
            "notes": "sin(-pi/2) = -1"
        },
        {
            "id": "tan_002",
            "input": "tan(pi/4)",
            "expected": 1.0,
            "expectedType": "NodeDouble",
            "notes": "tan(pi/4) = 1"
        },
        {
            "id": "tan_003",
            "input": "tan(-pi/4)",
            "expected": -1.0,
            "expectedType": "NodeDouble",
            "notes": "tan(-pi/4) = -1"
        },
        {
            "id": "sin_of_degree_quantity",
            "input": "sin(90 degrees)",
            "expected": 1.0,
            "expectedType": "NodeDouble",
            "tolerance": 1e-12,
            "notes": "The argument's own angle label says which unit it is in, so no configuration change is needed to ask this"
        },
        {
            "id": "cos_of_gradian_quantity",
            "input": "cos(100 gradians)",
            "expected": 0.0,
            "expectedType": "NodeDouble",
            "tolerance": 1e-12,
            "notes": "Every angle unit in the registry works, not only the two the configuration offers"
        },
        {
            "id": "sin_of_radian_quantity_in_degree_mode",
            "input": "sin(1 radian)",
            "expected": 0.8414709848078965,
            "expectedType": "NodeDouble",
            "config": {
                "angleUnit": "DEGREES"
            },
            "tolerance": 1e-12,
            "notes": "The label beats the configured angle unit, which is the point of honouring it"
        },
        {
            "id": "trig_answer_has_no_label",
            "input": "typeof(sin(90 degrees))",
            "expected": "double",
            "expectedType": "NodeString",
            "notes": "A sine is a ratio, so the answer carries no marker however the argument was written"
        },
        {
            "id": "sin_of_non_angle_quantity",
            "input": "sin(3 meters)",
            "expected": 0.1411200080598672,
            "expectedType": "NodeDouble",
            "tolerance": 1e-12,
            "notes": "A label that is not an angle says nothing about how to read the argument, so the magnitude is used as it stands"
        },
        {
            "id": "sin_broadcasts_over_angle_quantities",
            "input": "sin({0 degrees, 90 degrees})",
            "expected": [
                0.0,
                1.0
            ],
            "expectedType": "NodeVector",
            "tolerance": 1e-12,
            "notes": "Each element is read through its own label"
        }
    ]
}
