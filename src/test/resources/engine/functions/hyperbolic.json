{
    "category": "Functions: hyperbolic",
    "description": "Hyperbolic functions and their inverses, including the reciprocal forms.",
    "tests": [
        {
            "id": "acosh_001",
            "input": "acosh(1)",
            "expected": 0.0,
            "expectedType": "NodeDouble",
            "notes": "acosh(1) = 0"
        },
        {
            "id": "acosh_002",
            "input": "acosh(2)",
            "expected": 1.3169578969248166,
            "expectedType": "NodeDouble",
            "notes": "acosh(2)"
        },
        {
            "id": "asinh_001",
            "input": "asinh(0)",
            "expected": 0.0,
            "expectedType": "NodeDouble",
            "notes": "asinh(0) = 0"
        },
        {
            "id": "asinh_002",
            "input": "asinh(1)",
            "expected": 0.881373587019543,
            "expectedType": "NodeDouble",
            "notes": "asinh(1)"
        },
        {
            "id": "atanh_001",
            "input": "atanh(0)",
            "expected": 0.0,
            "expectedType": "NodeDouble",
            "notes": "atanh(0) = 0"
        },
        {
            "id": "atanh_002",
            "input": "atanh(0.5)",
            "expected": 0.5493061443340548,
            "expectedType": "NodeDouble",
            "notes": "atanh(0.5)"
        },
        {
            "id": "builtin_math_032",
            "input": "sinh(0)",
            "expected": 0.0,
            "expectedType": "NodeDouble",
            "notes": "Hyperbolic sine"
        },
        {
            "id": "builtin_math_033",
            "input": "cosh(0)",
            "expected": 1.0,
            "expectedType": "NodeDouble",
            "notes": "Hyperbolic cosine"
        },
        {
            "id": "builtin_math_034",
            "input": "tanh(0)",
            "expected": 0.0,
            "expectedType": "NodeDouble",
            "notes": "Hyperbolic tangent"
        },
        {
            "id": "cosh_002",
            "input": "cosh(1)",
            "expected": 1.5430806348152437,
            "expectedType": "NodeDouble",
            "notes": "cosh(1)"
        },
        {
            "id": "cosh_003",
            "input": "cosh(-1)",
            "expected": 1.5430806348152437,
            "expectedType": "NodeDouble",
            "notes": "cosh(-1) = cosh(1) (even function)"
        },
        {
            "id": "coth_001",
            "input": "coth(1)",
            "expected": 1.3130352854993312,
            "expectedType": "NodeDouble",
            "notes": "coth(1) = 1/tanh(1)"
        },
        {
            "id": "csch_001",
            "input": "csch(1)",
            "expected": 0.8509181282393216,
            "expectedType": "NodeDouble",
            "notes": "csch(1) = 1/sinh(1)"
        },
        {
            "id": "identity_001",
            "input": "cosh(0)^2 - sinh(0)^2",
            "expected": 1.0,
            "expectedType": "NodeDouble",
            "notes": "Hyperbolic identity: cosh^2 - sinh^2 = 1"
        },
        {
            "id": "identity_002",
            "input": "cosh(1)^2 - sinh(1)^2",
            "expected": 1.0,
            "expectedType": "NodeDouble",
            "notes": "Hyperbolic identity at x=1"
        },
        {
            "id": "sech_001",
            "input": "sech(0)",
            "expected": 1.0,
            "expectedType": "NodeDouble",
            "notes": "sech(0) = 1/cosh(0) = 1"
        },
        {
            "id": "sinh_002",
            "input": "sinh(1)",
            "expected": 1.1752011936438014,
            "expectedType": "NodeDouble",
            "notes": "sinh(1)"
        },
        {
            "id": "sinh_003",
            "input": "sinh(-1)",
            "expected": -1.1752011936438014,
            "expectedType": "NodeDouble",
            "notes": "sinh(-1) = -sinh(1)"
        },
        {
            "id": "tanh_002",
            "input": "tanh(1)",
            "expected": 0.7615941559557649,
            "expectedType": "NodeDouble",
            "notes": "tanh(1)"
        },
        {
            "id": "tanh_003",
            "input": "tanh(-1)",
            "expected": -0.7615941559557649,
            "expectedType": "NodeDouble",
            "notes": "tanh(-1) = -tanh(1)"
        },
        {
            "id": "asech_at_one",
            "input": "asech(1)",
            "expected": 0.0,
            "expectedType": "NodeDouble",
            "notes": "acosh(1) = 0"
        },
        {
            "id": "asech_001",
            "input": "asech(0.5)",
            "expected": 1.3169578969248166,
            "expectedType": "NodeDouble",
            "notes": "asech(x) is acosh(1/x)"
        },
        {
            "id": "asech_matches_acosh",
            "input": "asech(0.5) == acosh(2)",
            "expected": true,
            "expectedType": "NodeBoolean",
            "notes": "Which is the definition, so the two agree exactly"
        },
        {
            "id": "acsch_001",
            "input": "acsch(1)",
            "expected": 0.8813735870195429,
            "expectedType": "NodeDouble",
            "notes": "acsch(x) is asinh(1/x)"
        },
        {
            "id": "acsch_negative",
            "input": "acsch(-1)",
            "expected": -0.8813735870195429,
            "expectedType": "NodeDouble",
            "notes": "Odd, like asinh"
        },
        {
            "id": "acoth_001",
            "input": "acoth(2)",
            "expected": 0.5493061443340549,
            "expectedType": "NodeDouble",
            "notes": "acoth(x) is atanh(1/x)"
        },
        {
            "id": "acoth_negative",
            "input": "acoth(-2)",
            "expected": -0.5493061443340549,
            "expectedType": "NodeDouble",
            "notes": "Odd, like atanh"
        },
        {
            "id": "asech_round_trip",
            "input": "sech(asech(0.5))",
            "expected": 0.5,
            "expectedType": "NodeDouble",
            "notes": "The inverse undoes the function",
            "tolerance": 1e-09
        },
        {
            "id": "asech_broadcasts",
            "input": "asech({0.5, 1})",
            "expected": [
                1.3169578969248166,
                0
            ],
            "expectedType": "NodeVector",
            "notes": "Element-wise over a vector"
        }
    ]
}
