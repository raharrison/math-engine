{
    "category": "Functions: rounding",
    "description": "Moving a value to a whole number, and rounding to a fixed number of places. An exact input keeps an exact result.",
    "tests": [
        {
            "id": "builtin_math_020",
            "input": "round(3.2)",
            "expected": 3.0,
            "expectedType": "NodeRational",
            "notes": "Round down"
        },
        {
            "id": "builtin_math_021",
            "input": "round(3.7)",
            "expected": 4.0,
            "expectedType": "NodeRational",
            "notes": "Round up"
        },
        {
            "id": "ceil_001",
            "input": "ceil(3.2)",
            "expected": 4.0,
            "expectedType": "NodeRational",
            "notes": "Ceiling of positive decimal"
        },
        {
            "id": "ceil_002",
            "input": "ceil(3.7)",
            "expected": 4.0,
            "expectedType": "NodeRational",
            "notes": "Ceiling of positive decimal"
        },
        {
            "id": "ceil_003",
            "input": "ceil(-3.2)",
            "expected": -3.0,
            "expectedType": "NodeRational",
            "notes": "Ceiling of negative rounds toward +infinity"
        },
        {
            "id": "ceil_004",
            "input": "ceil(-3.7)",
            "expected": -3.0,
            "expectedType": "NodeRational",
            "notes": "Ceiling of negative decimal"
        },
        {
            "id": "ceil_005",
            "input": "ceil(5)",
            "expected": 5,
            "expectedType": "NodeRational",
            "notes": "Ceiling of integer preserves rational"
        },
        {
            "id": "ceil_006",
            "input": "ceil(0)",
            "expected": 0,
            "expectedType": "NodeRational",
            "notes": "Ceiling of zero preserves rational"
        },
        {
            "id": "floor_002",
            "input": "floor(3.2)",
            "expected": 3.0,
            "expectedType": "NodeRational",
            "notes": "Floor of positive decimal less than 0.5"
        },
        {
            "id": "floor_003",
            "input": "floor(-3.2)",
            "expected": -4.0,
            "expectedType": "NodeRational",
            "notes": "Floor of negative rounds toward -infinity"
        },
        {
            "id": "floor_004",
            "input": "floor(-3.7)",
            "expected": -4.0,
            "expectedType": "NodeRational",
            "notes": "Floor of negative decimal"
        },
        {
            "id": "floor_005",
            "input": "floor(5)",
            "expected": 5,
            "expectedType": "NodeRational",
            "notes": "Floor of integer preserves rational"
        },
        {
            "id": "floor_006",
            "input": "floor(0)",
            "expected": 0,
            "expectedType": "NodeRational",
            "notes": "Floor of zero preserves rational"
        },
        {
            "id": "round_003",
            "input": "round(3.5)",
            "expected": 4.0,
            "expectedType": "NodeRational",
            "notes": "Round half up"
        },
        {
            "id": "round_004",
            "input": "round(-3.2)",
            "expected": -3.0,
            "expectedType": "NodeRational",
            "notes": "Round negative toward zero"
        },
        {
            "id": "round_005",
            "input": "round(-3.7)",
            "expected": -4.0,
            "expectedType": "NodeRational",
            "notes": "Round negative away from zero"
        },
        {
            "id": "round_006",
            "input": "round(0)",
            "expected": 0,
            "expectedType": "NodeRational",
            "notes": "Round zero preserves rational"
        },
        {
            "id": "roundn_001",
            "input": "roundn(3.14159, 2)",
            "expected": 3.14,
            "expectedType": "NodeDouble",
            "notes": "Round to 2 decimal places"
        },
        {
            "id": "roundn_002",
            "input": "roundn(3.14159, 4)",
            "expected": 3.1416,
            "expectedType": "NodeDouble",
            "notes": "Round to 4 decimal places"
        },
        {
            "id": "roundn_003",
            "input": "roundn(3.14159, 0)",
            "expected": 3.0,
            "expectedType": "NodeDouble",
            "notes": "Round to 0 decimal places"
        },
        {
            "id": "trunc_001",
            "input": "trunc(3.7)",
            "expected": 3.0,
            "expectedType": "NodeRational",
            "notes": "Truncate positive"
        },
        {
            "id": "trunc_002",
            "input": "trunc(-3.7)",
            "expected": -3.0,
            "expectedType": "NodeRational",
            "notes": "Truncate negative (toward zero)"
        },
        {
            "id": "trunc_003",
            "input": "trunc(5)",
            "expected": 5,
            "expectedType": "NodeRational",
            "notes": "Truncate integer preserves rational"
        }
    ]
}
