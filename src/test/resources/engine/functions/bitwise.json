{
    "category": "Functions: bitwise",
    "description": "Integer bit manipulation: masks, shifts, rotations and bit counting.",
    "tests": [
        {
            "id": "bitand_001",
            "input": "bitand(12, 10)",
            "expected": 8,
            "expectedType": "NodeRational",
            "notes": "1100 & 1010 = 1000"
        },
        {
            "id": "bitand_002",
            "input": "bitand(255, 15)",
            "expected": 15,
            "expectedType": "NodeRational",
            "notes": "11111111 & 00001111"
        },
        {
            "id": "bitand_003",
            "input": "bitand(7, 3, 1)",
            "expected": 1,
            "expectedType": "NodeRational",
            "notes": "Multiple arguments"
        },
        {
            "id": "bitand_004",
            "input": "bitand(0, 255)",
            "expected": 0,
            "expectedType": "NodeRational",
            "notes": "AND with 0"
        },
        {
            "id": "bitnot_001",
            "input": "bitnot(0)",
            "expected": -1,
            "expectedType": "NodeRational",
            "notes": "NOT of 0 is -1 (all bits set)"
        },
        {
            "id": "bitnot_002",
            "input": "bitnot(-1)",
            "expected": 0,
            "expectedType": "NodeRational",
            "notes": "NOT of -1 is 0"
        },
        {
            "id": "bitnot_003",
            "input": "bitnot(bitnot(42))",
            "expected": 42,
            "expectedType": "NodeRational",
            "notes": "Double NOT is identity"
        },
        {
            "id": "bitor_001",
            "input": "bitor(12, 10)",
            "expected": 14,
            "expectedType": "NodeRational",
            "notes": "1100 | 1010 = 1110"
        },
        {
            "id": "bitor_002",
            "input": "bitor(8, 4, 2, 1)",
            "expected": 15,
            "expectedType": "NodeRational",
            "notes": "Multiple arguments"
        },
        {
            "id": "bitor_003",
            "input": "bitor(0, 0)",
            "expected": 0,
            "expectedType": "NodeRational",
            "notes": "OR of zeros"
        },
        {
            "id": "bitreverse_001",
            "input": "bitreverse(1)",
            "expected": -9223372036854775808,
            "expectedType": "NodeRational",
            "notes": "Reverse bit pattern"
        },
        {
            "id": "bitxor_001",
            "input": "bitxor(12, 10)",
            "expected": 6,
            "expectedType": "NodeRational",
            "notes": "1100 ^ 1010 = 0110"
        },
        {
            "id": "bitxor_002",
            "input": "bitxor(255, 255)",
            "expected": 0,
            "expectedType": "NodeRational",
            "notes": "XOR with self is 0"
        },
        {
            "id": "bitxor_003",
            "input": "bitxor(5, 3, 1)",
            "expected": 7,
            "expectedType": "NodeRational",
            "notes": "Multiple arguments"
        },
        {
            "id": "clz_001",
            "input": "clz(1)",
            "expected": 63,
            "expectedType": "NodeRational",
            "notes": "Leading zeros in 64-bit 1"
        },
        {
            "id": "clz_002",
            "input": "clz(0)",
            "expected": 64,
            "expectedType": "NodeRational",
            "notes": "All zeros"
        },
        {
            "id": "ctz_001",
            "input": "ctz(8)",
            "expected": 3,
            "expectedType": "NodeRational",
            "notes": "1000 has 3 trailing zeros"
        },
        {
            "id": "ctz_002",
            "input": "ctz(1)",
            "expected": 0,
            "expectedType": "NodeRational",
            "notes": "No trailing zeros"
        },
        {
            "id": "ctz_003",
            "input": "ctz(16)",
            "expected": 4,
            "expectedType": "NodeRational",
            "notes": "10000 has 4 trailing zeros"
        },
        {
            "id": "lshift_001",
            "input": "lshift(1, 4)",
            "expected": 16,
            "expectedType": "NodeRational",
            "notes": "1 << 4 = 16"
        },
        {
            "id": "lshift_002",
            "input": "lshift(3, 2)",
            "expected": 12,
            "expectedType": "NodeRational",
            "notes": "3 << 2 = 12"
        },
        {
            "id": "lshift_003",
            "input": "lshift(1, 10)",
            "expected": 1024,
            "expectedType": "NodeRational",
            "notes": "1 << 10 = 1024"
        },
        {
            "id": "popcount_001",
            "input": "popcount(7)",
            "expected": 3,
            "expectedType": "NodeRational",
            "notes": "111 has 3 bits set"
        },
        {
            "id": "popcount_002",
            "input": "popcount(255)",
            "expected": 8,
            "expectedType": "NodeRational",
            "notes": "11111111 has 8 bits set"
        },
        {
            "id": "popcount_003",
            "input": "popcount(0)",
            "expected": 0,
            "expectedType": "NodeRational",
            "notes": "0 has no bits set"
        },
        {
            "id": "popcount_004",
            "input": "popcount(1024)",
            "expected": 1,
            "expectedType": "NodeRational",
            "notes": "Power of 2 has 1 bit set"
        },
        {
            "id": "rotl_001",
            "input": "rotl(1, 1)",
            "expected": 2,
            "expectedType": "NodeRational",
            "notes": "Rotate left by 1"
        },
        {
            "id": "rotr_001",
            "input": "rotr(2, 1)",
            "expected": 1,
            "expectedType": "NodeRational",
            "notes": "Rotate right by 1"
        },
        {
            "id": "rshift_001",
            "input": "rshift(16, 4)",
            "expected": 1,
            "expectedType": "NodeRational",
            "notes": "16 >> 4 = 1"
        },
        {
            "id": "rshift_002",
            "input": "rshift(255, 4)",
            "expected": 15,
            "expectedType": "NodeRational",
            "notes": "255 >> 4 = 15"
        },
        {
            "id": "rshift_003",
            "input": "rshift(-8, 2)",
            "expected": -2,
            "expectedType": "NodeRational",
            "notes": "Arithmetic right shift preserves sign"
        },
        {
            "id": "urshift_001",
            "input": "urshift(16, 4)",
            "expected": 1,
            "expectedType": "NodeRational",
            "notes": "Unsigned right shift"
        },
        {
            "id": "hex_of_255",
            "input": "hex(255)",
            "expected": "0xff",
            "expectedType": "NodeString",
            "notes": "Hexadecimal comes back with the 0x prefix, so it can be typed straight back in as a literal"
        },
        {
            "id": "hex_of_negative",
            "input": "hex(-255)",
            "expected": "-0xff",
            "expectedType": "NodeString",
            "notes": "A negative number keeps its sign in front of the prefix"
        },
        {
            "id": "hex_beyond_long",
            "input": "hex(2^80)",
            "expected": "0x100000000000000000000",
            "expectedType": "NodeString",
            "notes": "An exact integer past 64 bits keeps every digit rather than rounding through a double"
        },
        {
            "id": "hex_broadcasts",
            "input": "hex({10, 11})",
            "expected": [
                "0xa",
                "0xb"
            ],
            "expectedType": "NodeVector",
            "notes": "A vector is converted element by element"
        },
        {
            "id": "bin_of_10",
            "input": "bin(10)",
            "expected": "0b1010",
            "expectedType": "NodeString",
            "notes": "Binary comes back with the 0b prefix the lexer reads"
        },
        {
            "id": "oct_of_15",
            "input": "oct(15)",
            "expected": "0o17",
            "expectedType": "NodeString",
            "notes": "Octal comes back with the 0o prefix the lexer reads"
        },
        {
            "id": "tobase_36",
            "input": "tobase(255, 36)",
            "expected": "73",
            "expectedType": "NodeString",
            "notes": "Any base up to 36 uses digits then letters, with no prefix"
        },
        {
            "id": "tobase_2",
            "input": "tobase(10, 2)",
            "expected": "1010",
            "expectedType": "NodeString",
            "notes": "Base 2 without a prefix, unlike bin"
        },
        {
            "id": "frombase_hex",
            "input": "frombase(\"ff\", 16)",
            "expected": 255,
            "expectedType": "NodeRational",
            "notes": "Hex digits read back to an exact integer"
        },
        {
            "id": "frombase_accepts_prefix",
            "input": "frombase(\"0xFF\", 16)",
            "expected": 255,
            "expectedType": "NodeRational",
            "notes": "The prefix matching the base is accepted, and case does not matter"
        },
        {
            "id": "frombase_negative_binary",
            "input": "frombase(\"-1010\", 2)",
            "expected": -10,
            "expectedType": "NodeRational",
            "notes": "A leading minus sign is read"
        },
        {
            "id": "frombase_round_trips_tobase",
            "input": "frombase(tobase(123456789, 36), 36)",
            "expected": 123456789,
            "expectedType": "NodeRational",
            "notes": "Writing a number in a base and reading it back gives the number"
        }
    ]
}
