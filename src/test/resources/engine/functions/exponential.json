{
    "category": "Functions: exponential",
    "description": "Powers and roots: exp, sqrt, cbrt, nroot and pow, and which of them keep an exact result.",
    "tests": [
        {
            "id": "builtin_math_009",
            "input": "exp(0)",
            "expected": 1.0,
            "expectedType": "NodeDouble",
            "notes": "Exponential of 0"
        },
        {
            "id": "builtin_math_010",
            "input": "exp(1)",
            "expected": 2.718281828459045,
            "expectedType": "NodeDouble",
            "notes": "Exponential of 1"
        },
        {
            "id": "builtin_math_011",
            "input": "sqrt(0)",
            "expected": 0.0,
            "expectedType": "NodeDouble",
            "notes": "Square root of 0"
        },
        {
            "id": "builtin_math_012",
            "input": "sqrt(4)",
            "expected": 2.0,
            "expectedType": "NodeDouble",
            "notes": "Square root of 4"
        },
        {
            "id": "builtin_math_013",
            "input": "sqrt(9)",
            "expected": 3.0,
            "expectedType": "NodeDouble",
            "notes": "Square root of 9"
        },
        {
            "id": "builtin_math_014",
            "input": "cbrt(8)",
            "expected": 2.0,
            "expectedType": "NodeDouble",
            "notes": "Cube root of 8"
        },
        {
            "id": "builtin_math_015",
            "input": "cbrt(27)",
            "expected": 3.0,
            "expectedType": "NodeDouble",
            "notes": "Cube root of 27"
        },
        {
            "id": "cbrt_001",
            "input": "cbrt(0)",
            "expected": 0.0,
            "expectedType": "NodeDouble",
            "notes": "cbrt(0) = 0"
        },
        {
            "id": "cbrt_004",
            "input": "cbrt(-8)",
            "expected": -2.0,
            "expectedType": "NodeDouble",
            "notes": "cbrt(-8) = -2"
        },
        {
            "id": "exp10_001",
            "input": "exp10(0)",
            "expected": 1.0,
            "expectedType": "NodeDouble",
            "notes": "10^0 = 1"
        },
        {
            "id": "exp10_002",
            "input": "exp10(2)",
            "expected": 100.0,
            "expectedType": "NodeDouble",
            "notes": "10^2 = 100"
        },
        {
            "id": "exp10_003",
            "input": "exp10(3)",
            "expected": 1000.0,
            "expectedType": "NodeDouble",
            "notes": "10^3 = 1000"
        },
        {
            "id": "exp2_001",
            "input": "exp2(0)",
            "expected": 1.0,
            "expectedType": "NodeDouble",
            "notes": "2^0 = 1"
        },
        {
            "id": "exp2_002",
            "input": "exp2(3)",
            "expected": 8.0,
            "expectedType": "NodeDouble",
            "notes": "2^3 = 8"
        },
        {
            "id": "exp2_003",
            "input": "exp2(10)",
            "expected": 1024.0,
            "expectedType": "NodeDouble",
            "notes": "2^10 = 1024"
        },
        {
            "id": "exp_003",
            "input": "exp(-1)",
            "expected": 0.36787944117144233,
            "expectedType": "NodeDouble",
            "notes": "e^-1 = 1/e"
        },
        {
            "id": "exp_004",
            "input": "exp(2)",
            "expected": 7.38905609893065,
            "expectedType": "NodeDouble",
            "notes": "e^2"
        },
        {
            "id": "expm1_001",
            "input": "expm1(0)",
            "expected": 0.0,
            "expectedType": "NodeDouble",
            "notes": "e^0 - 1 = 0"
        },
        {
            "id": "expm1_002",
            "input": "expm1(1)",
            "expected": 1.718281828459045,
            "expectedType": "NodeDouble",
            "notes": "e^1 - 1 = e - 1"
        },
        {
            "id": "new_001",
            "input": "pow(2, 3)",
            "expected": 8.0,
            "expectedType": "NodeRational",
            "notes": "Power function: 2^3"
        },
        {
            "id": "new_002",
            "input": "pow(10, 2)",
            "expected": 100.0,
            "expectedType": "NodeRational",
            "notes": "Power function: 10^2"
        },
        {
            "id": "new_003",
            "input": "pow(5, 0)",
            "expected": 1.0,
            "expectedType": "NodeRational",
            "notes": "Power function: 5^0 = 1"
        },
        {
            "id": "new_004",
            "input": "pow(2, -1)",
            "expected": 0.5,
            "expectedType": "NodeRational",
            "notes": "Power function with negative exponent"
        },
        {
            "id": "new_005",
            "input": "pow(4, 0.5)",
            "expected": 2.0,
            "expectedType": "NodeDouble",
            "notes": "Power function with fractional exponent (square root)"
        },
        {
            "id": "nroot_001",
            "input": "nroot(16, 4)",
            "expected": 2.0,
            "expectedType": "NodeDouble",
            "notes": "4th root of 16 = 2"
        },
        {
            "id": "nroot_002",
            "input": "nroot(32, 5)",
            "expected": 2.0,
            "expectedType": "NodeDouble",
            "notes": "5th root of 32 = 2"
        },
        {
            "id": "sqrt_002",
            "input": "sqrt(1)",
            "expected": 1.0,
            "expectedType": "NodeDouble",
            "notes": "sqrt(1) = 1"
        },
        {
            "id": "sqrt_005",
            "input": "sqrt(16)",
            "expected": 4.0,
            "expectedType": "NodeDouble",
            "notes": "sqrt(16) = 4"
        },
        {
            "id": "sqrt_006",
            "input": "sqrt(2)",
            "expected": 1.4142135623730951,
            "expectedType": "NodeDouble",
            "notes": "sqrt(2) = 1.414..."
        }
    ]
}
