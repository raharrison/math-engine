{
    "category": "Functions: statistical",
    "description": "Descriptive statistics over a vector or a variadic argument list: spread, shape, percentiles and correlation.",
    "tests": [
        {
            "id": "correlation_001",
            "input": "correlation({1, 2, 3}, {1, 2, 3})",
            "expected": 1.0,
            "expectedType": "NodeDouble",
            "notes": "Perfect positive correlation"
        },
        {
            "id": "correlation_002",
            "input": "correlation({1, 2, 3}, {3, 2, 1})",
            "expected": -1.0,
            "expectedType": "NodeDouble",
            "notes": "Perfect negative correlation"
        },
        {
            "id": "correlation_003",
            "input": "correlation({1, 2, 3, 4, 5}, {2, 4, 5, 4, 5})",
            "expected": 0.7745966692414834,
            "expectedType": "NodeDouble",
            "notes": "Partial correlation"
        },
        {
            "id": "covariance_001",
            "input": "covariance({1, 2, 3}, {4, 5, 6})",
            "expected": 1,
            "expectedType": "NodeRational",
            "notes": "Covariance of two exact vectors stays exact"
        },
        {
            "id": "covariance_002",
            "input": "covariance({1, 2, 3, 4, 5}, {5, 4, 3, 2, 1})",
            "expected": "-5/2",
            "expectedType": "NodeRational",
            "notes": "A perfectly negative relationship, exact"
        },
        {
            "id": "gmean_001",
            "input": "gmean(2, 8)",
            "expected": 4.0,
            "expectedType": "NodeDouble",
            "notes": "Geometric mean of 2 and 8"
        },
        {
            "id": "gmean_002",
            "input": "gmean({1, 2, 4, 8})",
            "expected": 2.8284271247461903,
            "expectedType": "NodeDouble",
            "notes": "Geometric mean of powers of 2"
        },
        {
            "id": "gmean_003",
            "input": "gmean(1, 1, 1)",
            "expected": 1.0,
            "expectedType": "NodeDouble",
            "notes": "Geometric mean of ones"
        },
        {
            "id": "hmean_001",
            "input": "hmean(1, 2)",
            "expected": "4/3",
            "expectedType": "NodeRational",
            "notes": "n over the sum of the reciprocals, so 2/(1+1/2) stays exact"
        },
        {
            "id": "hmean_002",
            "input": "hmean({2, 4, 4})",
            "expected": 3,
            "expectedType": "NodeRational",
            "notes": "Harmonic mean of a vector"
        },
        {
            "id": "hmean_003",
            "input": "hmean(40, 60)",
            "expected": 48,
            "expectedType": "NodeRational",
            "notes": "The classic average-speed case, exact"
        },
        {
            "id": "iqr_001",
            "input": "iqr({1, 2, 3, 4, 5, 6, 7, 8})",
            "expected": "7/2",
            "expectedType": "NodeRational",
            "notes": "Q3 minus Q1, both interpolated between exact elements"
        },
        {
            "id": "iqr_002",
            "input": "iqr({2, 4, 4, 4, 5, 5, 7, 9})",
            "expected": "3/2",
            "expectedType": "NodeRational",
            "notes": "Interquartile range of a repeated dataset"
        },
        {
            "id": "kurtosis_001",
            "input": "kurtosis({1, 2, 3, 4, 5, 6, 7})",
            "expected": -1.25,
            "expectedType": "NodeDouble",
            "notes": "Kurtosis of uniform-like distribution"
        },
        {
            "id": "mode_001",
            "input": "mode({1, 2, 2, 3})",
            "expected": 2,
            "expectedType": "NodeRational",
            "notes": "Mode hands back one of its own inputs, so it keeps that input's type"
        },
        {
            "id": "mode_002",
            "input": "mode({1, 1, 2, 2, 2, 3, 3})",
            "expected": 2,
            "expectedType": "NodeRational",
            "notes": "The most frequent value wins"
        },
        {
            "id": "mode_003",
            "input": "mode({5, 5, 5, 5})",
            "expected": 5,
            "expectedType": "NodeRational",
            "notes": "Every value is the mode when they are all equal"
        },
        {
            "id": "new_011",
            "input": "median({1, 2, 3})",
            "expected": 2.0,
            "expectedType": "NodeRational",
            "notes": "Median of odd-length vector"
        },
        {
            "id": "new_012",
            "input": "median({1, 2, 3, 4})",
            "expected": 2.5,
            "expectedType": "NodeRational",
            "notes": "Median of even-length vector (average of middle two)"
        },
        {
            "id": "new_013",
            "input": "median({5})",
            "expected": 5.0,
            "expectedType": "NodeRational",
            "notes": "Median of single-element vector"
        },
        {
            "id": "new_014",
            "input": "median({10, 1, 5, 3, 7})",
            "expected": 5.0,
            "expectedType": "NodeRational",
            "notes": "Median of unsorted vector"
        },
        {
            "id": "new_015",
            "input": "median(4, 2, 8, 1)",
            "expected": 3.0,
            "expectedType": "NodeRational",
            "notes": "Median with variadic arguments"
        },
        {
            "id": "new_016",
            "input": "median(7, 3)",
            "expected": 5.0,
            "expectedType": "NodeRational",
            "notes": "Median of two numbers"
        },
        {
            "id": "percentile_001",
            "input": "percentile({1, 2, 3, 4, 5}, 50)",
            "expected": 3,
            "expectedType": "NodeRational",
            "notes": "A percentile landing on an element returns that element untouched"
        },
        {
            "id": "percentile_002",
            "input": "percentile({1, 2, 3, 4, 5}, 0)",
            "expected": 1,
            "expectedType": "NodeRational",
            "notes": "The zeroth percentile is the smallest element"
        },
        {
            "id": "percentile_003",
            "input": "percentile({1, 2, 3, 4, 5}, 100)",
            "expected": 5,
            "expectedType": "NodeRational",
            "notes": "The hundredth is the largest"
        },
        {
            "id": "percentile_004",
            "input": "percentile({1, 2, 3, 4, 5}, 0.5)",
            "expected": 3,
            "expectedType": "NodeRational",
            "notes": "A fraction and a percentage mean the same thing"
        },
        {
            "id": "percentile_005",
            "input": "percentile({10, 20, 30, 40, 50}, 25)",
            "expected": 20,
            "expectedType": "NodeRational",
            "notes": "The quarter mark lands on an element"
        },
        {
            "id": "quartile_001",
            "input": "quartile({1, 2, 3, 4, 5, 6, 7, 8}, 1)",
            "expected": "11/4",
            "expectedType": "NodeRational",
            "notes": "Interpolated between two elements, exactly"
        },
        {
            "id": "quartile_002",
            "input": "quartile({1, 2, 3, 4, 5, 6, 7, 8}, 2)",
            "expected": "9/2",
            "expectedType": "NodeRational",
            "notes": "The second quartile is the median"
        },
        {
            "id": "quartile_003",
            "input": "quartile({1, 2, 3, 4, 5, 6, 7, 8}, 3)",
            "expected": "25/4",
            "expectedType": "NodeRational",
            "notes": "Interpolated between two elements, exactly"
        },
        {
            "id": "range_001",
            "input": "range({1, 5, 3, 9, 2})",
            "expected": 8,
            "expectedType": "NodeRational",
            "notes": "Largest minus smallest, which is arithmetic on the elements"
        },
        {
            "id": "range_002",
            "input": "range({5, 5, 5})",
            "expected": 0,
            "expectedType": "NodeRational",
            "notes": "No spread at all"
        },
        {
            "id": "range_003",
            "input": "range(1, 2, 3, 4, 5)",
            "expected": 4,
            "expectedType": "NodeRational",
            "notes": "Loose arguments and a vector agree"
        },
        {
            "id": "rms_001",
            "input": "rms({3, 4})",
            "expected": 3.5355339059327378,
            "expectedType": "NodeDouble",
            "notes": "Root mean square of 3 and 4"
        },
        {
            "id": "rms_002",
            "input": "rms({1, 2, 3, 4, 5})",
            "expected": 3.3166247903554,
            "expectedType": "NodeDouble",
            "notes": "RMS of 1 to 5"
        },
        {
            "id": "rms_003",
            "input": "rms(1, 1, 1)",
            "expected": 1.0,
            "expectedType": "NodeDouble",
            "notes": "RMS of equal values"
        },
        {
            "id": "skewness_001",
            "input": "skewness({1, 2, 3, 4, 5})",
            "expected": 0.0,
            "expectedType": "NodeDouble",
            "notes": "Skewness of symmetric distribution"
        },
        {
            "id": "skewness_002",
            "input": "skewness({1, 1, 1, 2, 5})",
            "expected": 1.2909944487358056,
            "expectedType": "NodeDouble",
            "notes": "Positive skewness (right tail)"
        },
        {
            "id": "stddev_001",
            "input": "stddev({2, 4, 4, 4, 5, 5, 7, 9})",
            "expected": 2.138089935299395,
            "expectedType": "NodeDouble",
            "notes": "Sample standard deviation"
        },
        {
            "id": "stddev_002",
            "input": "stddev({10, 10, 10})",
            "expected": 0.0,
            "expectedType": "NodeDouble",
            "notes": "Standard deviation of identical values"
        },
        {
            "id": "variance_001",
            "input": "variance({2, 4, 4, 4, 5, 5, 7, 9})",
            "expected": "32/7",
            "expectedType": "NodeRational",
            "notes": "Sample variance of exact inputs is exact"
        },
        {
            "id": "variance_002",
            "input": "variance({1, 1, 1, 1})",
            "expected": 0,
            "expectedType": "NodeRational",
            "notes": "Identical values have no variance"
        },
        {
            "id": "mode_keeps_the_unit",
            "input": "mode({1 m, 1 m, 2 m})",
            "expected": "1.0 meter",
            "expectedType": "NodeUnit",
            "notes": "Mode returns one of its own inputs, so it returns it whole. This used to be a plain 1"
        },
        {
            "id": "mode_keeps_exactness",
            "input": "mode({1/3, 1/3, 2/3})",
            "expected": "1/3",
            "expectedType": "NodeRational",
            "notes": "The same reason keeps the rational exact, where it used to become 0.3333333333333333"
        },
        {
            "id": "mode_matches_across_unit_scales",
            "input": "mode({1 m, 100 cm, 2 m})",
            "expected": "1.0 meter",
            "expectedType": "NodeUnit",
            "notes": "Equality converts units, so 1 m and 100 cm are one value counted twice, returned in the spelling that sorts first"
        },
        {
            "id": "mode_keeps_a_percentage",
            "input": "mode({10%, 10%, 20%})",
            "expected": "10%",
            "expectedType": "NodePercent",
            "notes": "A percentage survives for the same reason a unit does"
        },
        {
            "id": "percentile_keeps_the_unit",
            "input": "percentile({1 m, 2 m, 3 m}, 50)",
            "expected": "2.0 meters",
            "expectedType": "NodeUnit",
            "notes": "A percentile landing on an element hands that element back, label and all"
        },
        {
            "id": "percentile_interpolates_exactly",
            "input": "percentile({1, 2}, 25)",
            "expected": "5/4",
            "expectedType": "NodeRational",
            "notes": "Between two elements it interpolates with exact arithmetic rather than in doubles"
        },
        {
            "id": "quartile_keeps_the_unit",
            "input": "quartile({1 m, 2 m, 3 m, 4 m}, 2)",
            "expected": "2.5 meters",
            "expectedType": "NodeUnit",
            "notes": "The median quartile falls between two elements and still carries the unit"
        },
        {
            "id": "range_keeps_the_unit",
            "input": "range({1 m, 5 m})",
            "expected": "4.0 meters",
            "expectedType": "NodeUnit",
            "notes": "Range is literally the largest minus the smallest, so it is a length. It used to be a plain 4"
        },
        {
            "id": "range_keeps_exactness",
            "input": "range({1/4, 3/4})",
            "expected": "1/2",
            "expectedType": "NodeRational",
            "notes": "Subtracting two exact values stays exact"
        },
        {
            "id": "iqr_keeps_the_unit",
            "input": "iqr({1 m, 2 m, 3 m, 4 m})",
            "expected": "1.5 meters",
            "expectedType": "NodeUnit",
            "notes": "Q3 minus Q1 is a difference of two lengths"
        },
        {
            "id": "hmean_keeps_the_unit",
            "input": "hmean({1 m, 2 m})",
            "expected": "1.3333333333333333 meters",
            "expectedType": "NodeUnit",
            "notes": "n over the sum of the reciprocals keeps the length"
        },
        {
            "id": "hmean_keeps_exactness",
            "input": "hmean({1/2, 1/3})",
            "expected": "2/5",
            "expectedType": "NodeRational",
            "notes": "Reciprocals of exact values are exact, so the harmonic mean is too"
        },
        {
            "id": "covariance_keeps_the_unit",
            "input": "covariance({1 m, 2 m, 3 m}, {1 m, 2 m, 4 m})",
            "expected": "1.5 meters",
            "expectedType": "NodeUnit",
            "notes": "A product of two lengths keeps one label, since there is no way to spell m^2"
        },
        {
            "id": "variance_keeps_the_unit",
            "input": "variance({1 m, 2 m})",
            "expected": "0.5 meters",
            "expectedType": "NodeUnit",
            "notes": "The true dimension is metres squared, which the engine cannot spell, so it keeps the label it had"
        },
        {
            "id": "stddev_keeps_the_unit",
            "input": "stddev({1 m, 2 m})",
            "expected": "0.7071067811865476 meters",
            "expectedType": "NodeUnit",
            "notes": "A square root is not exact, but the label rides along with the magnitude"
        },
        {
            "id": "rms_keeps_the_unit",
            "input": "rms({1 m, 2 m})",
            "expected": "1.5811388300841898 meters",
            "expectedType": "NodeUnit",
            "notes": "Root mean square is a length, arrived at through a root"
        },
        {
            "id": "gmean_keeps_the_unit",
            "input": "gmean({1 m, 4 m})",
            "expected": "2.0 meters",
            "expectedType": "NodeUnit",
            "notes": "Computed through logarithms to avoid overflow, then put back under the label its inputs wore"
        },
        {
            "id": "correlation_is_a_plain_ratio",
            "input": "correlation({1 m, 2 m, 3 m}, {1 m, 2 m, 4 m})",
            "expected": 0.9819805060619659,
            "expectedType": "NodeDouble",
            "notes": "Covariance over the two spreads divides like into like, so the label cancels with no special case"
        },
        {
            "id": "skewness_is_a_plain_ratio",
            "input": "skewness({1 m, 2 m, 4 m})",
            "expected": 0.3818017741606059,
            "expectedType": "NodeDouble",
            "notes": "Skewness is a shape measure, so a unit would be meaningless"
        },
        {
            "id": "kurtosis_is_a_plain_ratio",
            "input": "kurtosis({1 m, 2 m, 3 m, 9 m})",
            "expected": -0.7980853277835589,
            "expectedType": "NodeDouble",
            "notes": "Excess kurtosis is a shape measure, so a unit would be meaningless"
        }
    ]
}
