{
    "category": "Functions: matrix",
    "description": "Matrix properties, transformations, construction and element access.",
    "tests": [
        {
            "id": "adjugate_001",
            "input": "adjugate([[1, 2], [3, 4]])",
            "expected": [
                [
                    4,
                    -2
                ],
                [
                    -3,
                    1
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "The adjugate swaps the diagonal and negates the off-diagonal for a 2x2"
        },
        {
            "id": "adjugate_002",
            "input": "adjugate([[1, 2], [3, 4]]) @ [[1, 2], [3, 4]]",
            "expected": [
                [
                    -2,
                    0
                ],
                [
                    0,
                    -2
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "A matrix times its adjugate is the determinant times the identity"
        },
        {
            "id": "adjugate_003",
            "input": "adj([[2, 0], [0, 2]])",
            "expected": [
                [
                    2,
                    0
                ],
                [
                    0,
                    2
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "The adjugate of a scaled identity is itself"
        },
        {
            "id": "adjugate_exact",
            "input": "adjugate([[1, 2, 3], [4, 5, 6], [7, 8, 10]])",
            "expected": [
                [
                    2,
                    4,
                    -3
                ],
                [
                    2,
                    -11,
                    6
                ],
                [
                    -3,
                    6,
                    -3
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "The adjugate is built from cofactors, so it is exact when the matrix is"
        },
        {
            "id": "builtin_mat_005",
            "input": "trace([1, 2; 3, 4])",
            "expected": 5,
            "expectedType": "NodeRational",
            "notes": "Trace of 2x2 matrix"
        },
        {
            "id": "builtin_mat_006",
            "input": "trace([1, 2, 3; 4, 5, 6; 7, 8, 9])",
            "expected": 15,
            "expectedType": "NodeRational",
            "notes": "Trace of 3x3 matrix"
        },
        {
            "id": "builtin_mat_007",
            "input": "trace([1, 0; 0, 1])",
            "expected": 2,
            "expectedType": "NodeRational",
            "notes": "Trace of 2x2 identity"
        },
        {
            "id": "builtin_mat_008",
            "input": "length([1, 2; 3, 4])",
            "expected": [
                2,
                2
            ],
            "expectedType": "NodeVector",
            "notes": "Length of matrix returns dimensions"
        },
        {
            "id": "builtin_mat_009",
            "input": "length([1, 2, 3; 4, 5, 6])",
            "expected": [
                2,
                3
            ],
            "expectedType": "NodeVector",
            "notes": "Length of 2x3 matrix"
        },
        {
            "id": "cofactor_001",
            "input": "cofactor([[1, 2, 3], [4, 5, 6], [7, 8, 9]], 0, 0)",
            "expected": -3,
            "expectedType": "NodeRational",
            "notes": "Cofactor at (0,0) - same sign as minor; an exact matrix gives an exact minor"
        },
        {
            "id": "cofactor_002",
            "input": "cofactor([[1, 2, 3], [4, 5, 6], [7, 8, 9]], 0, 1)",
            "expected": 6,
            "expectedType": "NodeRational",
            "notes": "Cofactor at (0,1) - opposite sign; an exact matrix gives an exact minor"
        },
        {
            "id": "col_001",
            "input": "col([[1, 2, 3], [4, 5, 6]], 0)",
            "expected": [
                1,
                4
            ],
            "expectedType": "NodeVector",
            "notes": "Extract first column"
        },
        {
            "id": "col_002",
            "input": "col([[1, 2, 3], [4, 5, 6]], 2)",
            "expected": [
                3,
                6
            ],
            "expectedType": "NodeVector",
            "notes": "Extract third column"
        },
        {
            "id": "cols_001",
            "input": "cols([[1, 2, 3], [4, 5, 6]])",
            "expected": 3,
            "expectedType": "NodeRational",
            "notes": "Column count of 2x3 matrix"
        },
        {
            "id": "cols_002",
            "input": "cols([[1], [2], [3]])",
            "expected": 1,
            "expectedType": "NodeRational",
            "notes": "Column count of 3x1 matrix"
        },
        {
            "id": "det_001",
            "input": "det([[1, 0], [0, 1]])",
            "expected": 1,
            "expectedType": "NodeRational",
            "notes": "Determinant of identity matrix; an integer matrix has an exact integer determinant"
        },
        {
            "id": "det_002",
            "input": "det([[1, 2], [3, 4]])",
            "expected": -2,
            "expectedType": "NodeRational",
            "notes": "Determinant of 2x2 matrix; an integer matrix has an exact integer determinant"
        },
        {
            "id": "det_003",
            "input": "det([[1, 2, 3], [4, 5, 6], [7, 8, 9]])",
            "expected": 0,
            "expectedType": "NodeRational",
            "notes": "Determinant of singular matrix; an integer matrix has an exact integer determinant"
        },
        {
            "id": "det_004",
            "input": "det([[2, 0, 0], [0, 3, 0], [0, 0, 4]])",
            "expected": 24,
            "expectedType": "NodeRational",
            "notes": "Determinant of diagonal matrix; an integer matrix has an exact integer determinant"
        },
        {
            "id": "det_005",
            "input": "det([[5]])",
            "expected": 5,
            "expectedType": "NodeRational",
            "notes": "Determinant of 1x1 matrix; an integer matrix has an exact integer determinant"
        },
        {
            "id": "det_double_element",
            "input": "det([[1.5d, 0], [0, 2]])",
            "expected": 3.0,
            "expectedType": "NodeDouble",
            "notes": "One inexact element makes the whole determinant inexact"
        },
        {
            "id": "diag_001",
            "input": "diag({1, 2, 3})",
            "expected": [
                [
                    1,
                    0,
                    0
                ],
                [
                    0,
                    2,
                    0
                ],
                [
                    0,
                    0,
                    3
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Create diagonal matrix from vector"
        },
        {
            "id": "diag_002",
            "input": "diag([[1, 2, 3], [4, 5, 6], [7, 8, 9]])",
            "expected": [
                1,
                5,
                9
            ],
            "expectedType": "NodeVector",
            "notes": "Extract diagonal from matrix"
        },
        {
            "id": "diag_003",
            "input": "diag({5})",
            "expected": [
                [
                    5
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Single element diagonal matrix"
        },
        {
            "id": "identity_001_matrix",
            "input": "identity(2)",
            "expected": [
                [
                    1,
                    0
                ],
                [
                    0,
                    1
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "2x2 identity matrix"
        },
        {
            "id": "identity_002_matrix",
            "input": "identity(3)",
            "expected": [
                [
                    1,
                    0,
                    0
                ],
                [
                    0,
                    1,
                    0
                ],
                [
                    0,
                    0,
                    1
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "3x3 identity matrix"
        },
        {
            "id": "identity_003",
            "input": "identity(1)",
            "expected": [
                [
                    1
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "1x1 identity matrix"
        },
        {
            "id": "inverse_001",
            "input": "inverse([[1, 2], [3, 4]])",
            "expected": [
                [
                    -2,
                    1
                ],
                [
                    1.5,
                    -0.5
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Inverting an exact matrix gives exact rationals, not doubles that miss by 2e-16"
        },
        {
            "id": "inverse_002",
            "input": "inverse(identity(3))",
            "expected": [
                [
                    1,
                    0,
                    0
                ],
                [
                    0,
                    1,
                    0
                ],
                [
                    0,
                    0,
                    1
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Inverse of identity is identity"
        },
        {
            "id": "minor_001",
            "input": "minor([[1, 2, 3], [4, 5, 6], [7, 8, 9]], 0, 0)",
            "expected": -3,
            "expectedType": "NodeRational",
            "notes": "Minor at (0,0); an exact matrix gives an exact minor"
        },
        {
            "id": "norm_001",
            "input": "norm({3, 4})",
            "expected": 5.0,
            "expectedType": "NodeDouble",
            "notes": "Euclidean norm of vector"
        },
        {
            "id": "norm_002",
            "input": "norm([[1, 2], [2, 1]])",
            "expected": 3.1622776601683795,
            "expectedType": "NodeDouble",
            "notes": "Frobenius norm of matrix"
        },
        {
            "id": "norm_003",
            "input": "norm({1, 0, 0})",
            "expected": 1.0,
            "expectedType": "NodeDouble",
            "notes": "Norm of unit vector"
        },
        {
            "id": "ones_001",
            "input": "ones(2)",
            "expected": [
                [
                    1,
                    1
                ],
                [
                    1,
                    1
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "2x2 ones matrix"
        },
        {
            "id": "ones_002",
            "input": "ones(2, 3)",
            "expected": [
                [
                    1,
                    1,
                    1
                ],
                [
                    1,
                    1,
                    1
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "2x3 ones matrix"
        },
        {
            "id": "rank_identity",
            "input": "rank([[1, 0], [0, 1]])",
            "expected": 2,
            "expectedType": "NodeRational",
            "notes": "Rank of identity matrix"
        },
        {
            "id": "rank_deficient",
            "input": "rank([[1, 2], [2, 4]])",
            "expected": 1,
            "expectedType": "NodeRational",
            "notes": "Rank of rank-deficient matrix"
        },
        {
            "id": "rank_zero_matrix",
            "input": "rank([[0, 0], [0, 0]])",
            "expected": 0,
            "expectedType": "NodeRational",
            "notes": "Rank of zero matrix"
        },
        {
            "id": "reshape_001",
            "input": "reshape({1, 2, 3, 4, 5, 6}, 2, 3)",
            "expected": [
                [
                    1,
                    2,
                    3
                ],
                [
                    4,
                    5,
                    6
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Reshape vector to 2x3 matrix"
        },
        {
            "id": "reshape_002",
            "input": "reshape({1, 2, 3, 4}, 2, 2)",
            "expected": [
                [
                    1,
                    2
                ],
                [
                    3,
                    4
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Reshape vector to 2x2 matrix"
        },
        {
            "id": "row_001",
            "input": "row([[1, 2, 3], [4, 5, 6]], 0)",
            "expected": [
                1,
                2,
                3
            ],
            "expectedType": "NodeVector",
            "notes": "Extract first row"
        },
        {
            "id": "row_002",
            "input": "row([[1, 2, 3], [4, 5, 6]], 1)",
            "expected": [
                4,
                5,
                6
            ],
            "expectedType": "NodeVector",
            "notes": "Extract second row"
        },
        {
            "id": "rows_001",
            "input": "rows([[1, 2, 3], [4, 5, 6]])",
            "expected": 2,
            "expectedType": "NodeRational",
            "notes": "Row count of 2x3 matrix"
        },
        {
            "id": "rows_002",
            "input": "rows([[1], [2], [3], [4]])",
            "expected": 4,
            "expectedType": "NodeRational",
            "notes": "Row count of 4x1 matrix"
        },
        {
            "id": "trace_001",
            "input": "trace([[1, 2], [3, 4]])",
            "expected": 5.0,
            "expectedType": "NodeRational",
            "notes": "Trace of 2x2 matrix"
        },
        {
            "id": "trace_002",
            "input": "trace([[1, 0, 0], [0, 2, 0], [0, 0, 3]])",
            "expected": 6.0,
            "expectedType": "NodeRational",
            "notes": "Trace of diagonal matrix"
        },
        {
            "id": "trace_003",
            "input": "trace(identity(5))",
            "expected": 5.0,
            "expectedType": "NodeRational",
            "notes": "Trace of 5x5 identity"
        },
        {
            "id": "transpose_001",
            "input": "transpose([[1, 2], [3, 4]])",
            "expected": [
                [
                    1,
                    3
                ],
                [
                    2,
                    4
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Transpose of 2x2 matrix"
        },
        {
            "id": "transpose_002",
            "input": "transpose([[1, 2, 3]])",
            "expected": [
                [
                    1
                ],
                [
                    2
                ],
                [
                    3
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Transpose of row vector"
        },
        {
            "id": "transpose_003",
            "input": "transpose([[1], [2], [3]])",
            "expected": [
                [
                    1,
                    2,
                    3
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Transpose of column vector"
        },
        {
            "id": "zeros_001",
            "input": "zeros(2)",
            "expected": [
                [
                    0,
                    0
                ],
                [
                    0,
                    0
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "2x2 zero matrix"
        },
        {
            "id": "zeros_002",
            "input": "zeros(2, 3)",
            "expected": [
                [
                    0,
                    0,
                    0
                ],
                [
                    0,
                    0,
                    0
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "2x3 zero matrix"
        },
        {
            "id": "rank_exact_small_element",
            "input": "rank([1/100000000000, 0; 0, 0])",
            "expected": 1,
            "expectedType": "NodeRational",
            "notes": "The reduction runs in the element type, so a genuinely tiny exact element is still a pivot; a 1e-10 threshold in doubles called this matrix empty"
        },
        {
            "id": "rank_exact_rationals",
            "input": "rank([1/3, 1/3; 1/3, 1/3])",
            "expected": 1,
            "expectedType": "NodeRational",
            "notes": "Rows that are exact multiples of one another cancel to exactly zero, with no threshold to guess about"
        },
        {
            "id": "rank_wider_than_tall",
            "input": "rank([1, 2, 3; 4, 5, 6])",
            "expected": 2,
            "expectedType": "NodeRational",
            "notes": "Rank is bounded by the shorter side, so a two-row matrix cannot exceed two"
        }
    ]
}
