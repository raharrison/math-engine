{
    "category": "Value: range",
    "description": "A range as a value: its bounds, its step, and the vector it stands for.",
    "tests": [
        {
            "id": "range_005",
            "input": "{1, 2, 3} + (1..3)",
            "expected": [
                2,
                4,
                6
            ],
            "expectedType": "NodeVector",
            "notes": "Range converts to vector in arithmetic"
        },
        {
            "id": "range_006",
            "input": "(1..3) * 2",
            "expected": [
                2,
                4,
                6
            ],
            "expectedType": "NodeVector",
            "notes": "Range multiplication"
        },
        {
            "id": "range_007",
            "input": "2 * (1..3)",
            "expected": [
                2,
                4,
                6
            ],
            "expectedType": "NodeVector",
            "notes": "Scalar times range"
        },
        {
            "id": "range_008",
            "input": "(1..5) + (1..5)",
            "expected": [
                2,
                4,
                6,
                8,
                10
            ],
            "expectedType": "NodeVector",
            "notes": "Range + Range (parenthesized for clarity)"
        },
        {
            "id": "range_arithmetic_001",
            "input": "(1..5) * 2",
            "expected": [
                2,
                4,
                6,
                8,
                10
            ],
            "expectedType": "NodeVector",
            "notes": "Multiply range by scalar"
        },
        {
            "id": "range_arithmetic_002",
            "input": "(1..5) + 10",
            "expected": [
                11,
                12,
                13,
                14,
                15
            ],
            "expectedType": "NodeVector",
            "notes": "Add scalar to range"
        },
        {
            "id": "range_func_001",
            "input": "sqrt(1..4)",
            "expected": [
                1,
                1.4142135623730951,
                1.7320508075688772,
                2
            ],
            "expectedType": "NodeVector",
            "notes": "Function on range"
        },
        {
            "id": "range_in_expr_001",
            "input": "sum(1..5) + sum(6..10)",
            "expected": 55,
            "expectedType": "NodeRational",
            "notes": "Ranges in expression"
        },
        {
            "id": "range_length_001",
            "input": "length(1..10)",
            "expected": 10,
            "expectedType": "NodeRational",
            "notes": "Length of range"
        },
        {
            "id": "range_max_001",
            "input": "max(5..15)",
            "expected": 15.0,
            "expectedType": "NodeRational",
            "notes": "Max of range"
        },
        {
            "id": "range_mean_001",
            "input": "mean(1..9)",
            "expected": 5.0,
            "expectedType": "NodeRational",
            "notes": "Mean of range"
        },
        {
            "id": "range_min_001",
            "input": "min(5..15)",
            "expected": 5.0,
            "expectedType": "NodeRational",
            "notes": "Min of range"
        },
        {
            "id": "range_product_001",
            "input": "product(1..5)",
            "expected": 120,
            "expectedType": "NodeRational",
            "notes": "Product of 1 to 5 (5!)"
        },
        {
            "id": "range_squared_001",
            "input": "(1..5) ^ 2",
            "expected": [
                1,
                4,
                9,
                16,
                25
            ],
            "expectedType": "NodeVector",
            "notes": "Square each element"
        },
        {
            "id": "range_sum_001",
            "input": "sum(1..10)",
            "expected": 55,
            "expectedType": "NodeRational",
            "notes": "Sum of 1 to 10"
        },
        {
            "id": "range_variable_001",
            "input": "r := 1..5; sum(r)",
            "expected": 15,
            "expectedType": "NodeRational",
            "notes": "Range assigned to variable"
        }
    ]
}
