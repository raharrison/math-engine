            "input": "(1..2) mod (20%)",
            "expected": [
                0.0,
                0.0
            ],
            "expectedType": "NodeVector",
            "notes": "Range takes the modulo of a percent"
        },
        {
            "id": "modulo_types_range_range",
            "input": "(1..2) mod (1..2)",
            "expected": [
                0,
                0
            ],
            "expectedType": "NodeVector",
            "notes": "Range takes the modulo of a range"
        },
        {
            "id": "modulo_types_range_rational",
            "input": "(1..2) mod (3)",
            "expected": [
                1,
                2
            ],
            "expectedType": "NodeVector",
            "notes": "Range takes the modulo of a rational"
