        },
        {
            "id": "modulo_types_range_vector",
            "input": "(1..2) mod ({1, 2})",
            "expected": [
                0,
                0
            ],
            "expectedType": "NodeVector",
            "notes": "Range takes the modulo of a vector"
        },
        {
