            "notes": "Rational takes the modulo of a string is not defined"
        },
        {
            "id": "modulo_types_rational_unit",
            "input": "(3) mod (4 meters)",
            "expected": "3.0 meters",
            "expectedType": "NodeUnit",
            "notes": "Three modulo four metres is three metres, since three is read in metres"
        },
        {
            "id": "modulo_types_rational_vector",
            "input": "(3) mod ({1, 2})",
            "expected": [
                0,
