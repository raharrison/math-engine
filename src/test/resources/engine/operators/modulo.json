        {
            "id": "modulo_types_percent_rational",
            "input": "(20%) mod (3)",
            "expected": "1/5",
            "expectedType": "NodeRational",
            "notes": "Percent takes the modulo of a rational"
        },
        {
            "id": "modulo_types_percent_string",
            "input": "(20%) mod (\"ab\")",
