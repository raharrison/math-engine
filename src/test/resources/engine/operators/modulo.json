{
    "category": "Operator: mod (modulo)",
    "description": "Floor modulo, so the result takes the sign of the divisor, across every operand type.",
    "tests": [
        {
            "id": "mod_001",
            "input": "7 mod 3",
            "expected": 1,
            "expectedType": "NodeRational",
            "notes": "Modulo preserves rational for integer inputs"
        },
        {
            "id": "mod_003_modulo",
            "input": "15 mod 4",
            "expected": 3,
            "expectedType": "NodeRational",
            "notes": "Modulo with remainder"
        },
        {
            "id": "mod_005",
            "input": "7 mod -3",
            "expected": -2,
            "expectedType": "NodeRational",
            "notes": "Floor modulo with negative divisor"
        },
        {
            "id": "mod_006",
            "input": "0 mod 5",
            "expected": 0,
            "expectedType": "NodeRational",
            "notes": "Zero modulo anything"
        },
        {
            "id": "mod_zero_001",
            "input": "5 mod 0",
            "expected": "NaN",
            "expectedType": "NodeDouble",
            "notes": "Modulo by zero"
        },
        {
            "id": "mod_zero_001_modulo",
            "input": "10 mod 0",
            "expected": "NaN",
            "expectedType": "NodeDouble",
            "notes": "Modulo by zero produces NaN"
        },
        {
            "id": "modulo_types_boolean_boolean",
            "input": "(true) mod (true)",
            "expected": 0,
            "expectedType": "NodeRational",
            "notes": "Boolean takes the modulo of a boolean"
        },
        {
            "id": "modulo_types_boolean_double",
            "input": "(true) mod (2.5d)",
            "expected": 1.0,
            "expectedType": "NodeDouble",
            "notes": "Boolean takes the modulo of a double"
        },
        {
            "id": "modulo_types_boolean_matrix",
            "input": "(true) mod ([1, 2; 3, 4])",
            "expected": [
                [
                    0,
                    1
                ],
                [
                    1,
                    1
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Boolean takes the modulo of a matrix"
        },
        {
            "id": "modulo_types_boolean_percent",
            "input": "(true) mod (20%)",
            "expected": 0,
            "expectedType": "NodeRational",
            "notes": "Boolean takes the modulo of a percent"
        },
        {
            "id": "modulo_types_boolean_range",
            "input": "(true) mod (1..2)",
            "expected": [
                0,
                1
            ],
            "expectedType": "NodeVector",
            "notes": "Boolean takes the modulo of a range"
        },
        {
            "id": "modulo_types_boolean_rational",
            "input": "(true) mod (3)",
            "expected": 1,
            "expectedType": "NodeRational",
            "notes": "Boolean takes the modulo of a rational"
        },
        {
            "id": "modulo_types_boolean_string",
            "input": "(true) mod (\"ab\")",
            "expectError": true,
            "expectedErrorType": "TypeError",
            "notes": "Boolean takes the modulo of a string is not defined"
        },
        {
            "id": "modulo_types_boolean_unit",
            "input": "(true) mod (4 meters)",
            "expected": "1.0 meter",
            "expectedType": "NodeUnit",
            "notes": "A boolean modulo a quantity keeps the label"
        },
        {
            "id": "modulo_types_boolean_vector",
            "input": "(true) mod ({1, 2})",
            "expected": [
                0,
                1
            ],
            "expectedType": "NodeVector",
            "notes": "Boolean takes the modulo of a vector"
        },
        {
            "id": "modulo_types_double_boolean",
            "input": "(2.5d) mod (true)",
            "expected": 0.5,
            "expectedType": "NodeDouble",
            "notes": "Double takes the modulo of a boolean"
        },
        {
            "id": "modulo_types_double_double",
            "input": "(2.5d) mod (2.5d)",
            "expected": 0.0,
            "expectedType": "NodeDouble",
            "notes": "Double takes the modulo of a double"
        },
        {
            "id": "modulo_types_double_matrix",
            "input": "(2.5d) mod ([1, 2; 3, 4])",
            "expected": [
                [
                    0.5,
                    0.5
                ],
                [
                    2.5,
                    2.5
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Double takes the modulo of a matrix"
        },
        {
            "id": "modulo_types_double_percent",
            "input": "(2.5d) mod (20%)",
            "expected": 0.09999999999999964,
            "expectedType": "NodeDouble",
            "notes": "Double takes the modulo of a percent"
        },
        {
            "id": "modulo_types_double_range",
            "input": "(2.5d) mod (1..2)",
            "expected": [
                0.5,
                0.5
            ],
            "expectedType": "NodeVector",
            "notes": "Double takes the modulo of a range"
        },
        {
            "id": "modulo_types_double_rational",
            "input": "(2.5d) mod (3)",
            "expected": 2.5,
            "expectedType": "NodeDouble",
            "notes": "Double takes the modulo of a rational"
        },
        {
            "id": "modulo_types_double_string",
            "input": "(2.5d) mod (\"ab\")",
            "expectError": true,
            "expectedErrorType": "TypeError",
            "notes": "Double takes the modulo of a string is not defined"
        },
        {
            "id": "modulo_types_double_unit",
            "input": "(2.5d) mod (4 meters)",
            "expected": "2.5 meters",
            "expectedType": "NodeUnit",
            "notes": "A double modulo a quantity keeps the label"
        },
        {
            "id": "modulo_types_double_vector",
            "input": "(2.5d) mod ({1, 2})",
            "expected": [
                0.5,
                0.5
            ],
            "expectedType": "NodeVector",
            "notes": "Double takes the modulo of a vector"
        },
        {
            "id": "modulo_types_matrix_boolean",
            "input": "([1, 2; 3, 4]) mod (true)",
            "expected": [
                [
                    0,
                    0
                ],
                [
                    0,
                    0
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Matrix takes the modulo of a boolean"
        },
        {
            "id": "modulo_types_matrix_double",
            "input": "([1, 2; 3, 4]) mod (2.5d)",
            "expected": [
                [
                    1.0,
                    2.0
                ],
                [
                    0.5,
                    1.5
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Matrix takes the modulo of a double"
        },
        {
            "id": "modulo_types_matrix_matrix",
            "input": "([1, 2; 3, 4]) mod ([1, 2; 3, 4])",
            "expected": [
                [
                    0,
                    0
                ],
                [
                    0,
                    0
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Matrix takes the modulo of a matrix"
        },
        {
            "id": "modulo_types_matrix_percent",
            "input": "([1, 2; 3, 4]) mod (20%)",
            "expected": [
                [
                    0.0,
                    0.0
                ],
                [
                    0.0,
                    0.0
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Matrix takes the modulo of a percent"
        },
        {
            "id": "modulo_types_matrix_range",
            "input": "([1, 2; 3, 4]) mod (1..2)",
            "expected": [
                [
                    0,
                    0
                ],
                [
                    0,
                    0
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Matrix takes the modulo of a range"
        },
        {
            "id": "modulo_types_matrix_rational",
            "input": "([1, 2; 3, 4]) mod (3)",
            "expected": [
                [
                    1,
                    2
                ],
                [
                    0,
                    1
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Matrix takes the modulo of a rational"
        },
        {
            "id": "modulo_types_matrix_string",
            "input": "([1, 2; 3, 4]) mod (\"ab\")",
            "expectError": true,
            "expectedErrorType": "TypeError",
            "notes": "Matrix takes the modulo of a string is not defined"
        },
        {
            "id": "modulo_types_matrix_unit",
            "input": "([1, 2; 3, 4]) mod (4 meters)",
            "expected": [
                [
                    "1.0 meter",
                    "2.0 meters"
                ],
                [
                    "3.0 meters",
                    "0.0 meters"
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "A matrix modulo a quantity broadcasts, and every element keeps the label"
        },
        {
            "id": "modulo_types_matrix_vector",
            "input": "([1, 2; 3, 4]) mod ({1, 2})",
            "expected": [
                [
                    0,
                    0
                ],
                [
                    0,
                    0
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Matrix takes the modulo of a vector"
        },
        {
            "id": "modulo_types_percent_boolean",
            "input": "(20%) mod (true)",
            "expected": "1/5",
            "expectedType": "NodeRational",
            "notes": "Percent takes the modulo of a boolean"
        },
        {
            "id": "modulo_types_percent_double",
            "input": "(20%) mod (2.5d)",
            "expected": 0.2,
            "expectedType": "NodeDouble",
            "notes": "Percent takes the modulo of a double"
        },
        {
            "id": "modulo_types_percent_matrix",
            "input": "(20%) mod ([1, 2; 3, 4])",
            "expected": [
                [
                    0.2,
                    0.2
