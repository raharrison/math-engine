{
    "category": "Operator: - (subtraction)",
    "description": "Subtraction across every operand type it accepts.",
    "tests": [
        {
            "id": "matrix_006",
            "input": "[5, 6; 7, 8] - [1, 2; 3, 4]",
            "expected": [
                [
                    4,
                    4
                ],
                [
                    4,
                    4
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Element-wise matrix subtraction"
        },
        {
            "id": "matrix_017",
            "input": "[1, 2; 3, 4] - [1, 2; 3, 4]",
            "expected": [
                [
                    0,
                    0
                ],
                [
                    0,
                    0
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Matrix subtraction yields zero matrix"
        },
        {
            "id": "matrix_sub_001",
            "input": "[[5, 6], [7, 8]] - [[1, 2], [3, 4]]",
            "expected": [
                [
                    4,
                    4
                ],
                [
                    4,
                    4
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Element-wise matrix subtraction"
        },
        {
            "id": "matrix_sub_002",
            "input": "[[10, 20], [30, 40]] - 5",
            "expected": [
                [
                    5,
                    15
                ],
                [
                    25,
                    35
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Scalar subtraction from matrix"
        },
        {
            "id": "sub_002",
            "input": "0 - 0",
            "expected": 0,
            "expectedType": "NodeRational",
            "notes": "Zero subtraction"
        },
        {
            "id": "sub_003",
            "input": "3 - 5",
            "expected": -2,
            "expectedType": "NodeRational",
            "notes": "Negative result"
        },
        {
            "id": "sub_005",
            "input": "10 - 5 - 2 - 1",
            "expected": 2,
            "expectedType": "NodeRational",
            "notes": "Multiple left-associative subtractions"
        },
        {
            "id": "subtract_types_boolean_boolean",
            "input": "(true) - (true)",
            "expected": 0,
            "expectedType": "NodeRational",
            "notes": "Boolean subtracts a boolean"
        },
        {
            "id": "subtract_types_boolean_double",
            "input": "(true) - (2.5d)",
            "expected": -1.5,
            "expectedType": "NodeDouble",
            "notes": "Boolean subtracts a double"
        },
        {
            "id": "subtract_types_boolean_matrix",
            "input": "(true) - ([1, 2; 3, 4])",
            "expected": [
                [
                    0,
                    -1
                ],
                [
                    -2,
                    -3
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Boolean subtracts a matrix"
        },
        {
            "id": "subtract_types_boolean_percent",
            "input": "(true) - (20%)",
            "expected": 0.8,
            "expectedType": "NodeDouble",
            "notes": "Boolean subtracts a percent"
        },
        {
            "id": "subtract_types_boolean_range",
            "input": "(true) - (1..2)",
            "expected": [
                0,
                -1
            ],
            "expectedType": "NodeVector",
            "notes": "Boolean subtracts a range"
        },
        {
            "id": "subtract_types_boolean_rational",
            "input": "(true) - (3)",
            "expected": -2,
            "expectedType": "NodeRational",
            "notes": "Boolean subtracts a rational"
        },
        {
            "id": "subtract_types_boolean_string",
            "input": "(true) - (\"ab\")",
            "expectError": true,
            "expectedErrorType": "TypeError",
            "notes": "Boolean subtracts a string is not defined"
        },
        {
            "id": "subtract_types_boolean_unit",
            "input": "(true) - (4 meters)",
            "expected": "-3.0 meters",
            "expectedType": "NodeUnit",
            "notes": "Boolean subtracts a unit"
        },
        {
            "id": "subtract_types_boolean_vector",
            "input": "(true) - ({1, 2})",
            "expected": [
                0,
                -1
            ],
            "expectedType": "NodeVector",
            "notes": "Boolean subtracts a vector"
        },
        {
            "id": "subtract_types_double_boolean",
            "input": "(2.5d) - (true)",
            "expected": 1.5,
            "expectedType": "NodeDouble",
            "notes": "Double subtracts a boolean"
        },
        {
            "id": "subtract_types_double_double",
            "input": "(2.5d) - (2.5d)",
            "expected": 0.0,
            "expectedType": "NodeDouble",
            "notes": "Double subtracts a double"
        },
        {
            "id": "subtract_types_double_matrix",
            "input": "(2.5d) - ([1, 2; 3, 4])",
            "expected": [
                [
                    1.5,
                    0.5
                ],
                [
                    -0.5,
                    -1.5
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Double subtracts a matrix"
        },
        {
            "id": "subtract_types_double_percent",
            "input": "(2.5d) - (20%)",
            "expected": 2.0,
            "expectedType": "NodeDouble",
            "notes": "Double subtracts a percent"
        },
        {
            "id": "subtract_types_double_range",
            "input": "(2.5d) - (1..2)",
            "expected": [
                1.5,
                0.5
            ],
            "expectedType": "NodeVector",
            "notes": "Double subtracts a range"
        },
        {
            "id": "subtract_types_double_rational",
            "input": "(2.5d) - (3)",
            "expected": -0.5,
            "expectedType": "NodeDouble",
            "notes": "Double subtracts a rational"
        },
        {
            "id": "subtract_types_double_string",
            "input": "(2.5d) - (\"ab\")",
            "expectError": true,
            "expectedErrorType": "TypeError",
            "notes": "Double subtracts a string is not defined"
        },
        {
            "id": "subtract_types_double_unit",
            "input": "(2.5d) - (4 meters)",
            "expected": "-1.5 meters",
            "expectedType": "NodeUnit",
            "notes": "Double subtracts a unit"
        },
        {
            "id": "subtract_types_double_vector",
            "input": "(2.5d) - ({1, 2})",
            "expected": [
                1.5,
                0.5
            ],
            "expectedType": "NodeVector",
            "notes": "Double subtracts a vector"
        },
        {
            "id": "subtract_types_matrix_boolean",
            "input": "([1, 2; 3, 4]) - (true)",
            "expected": [
                [
                    0,
                    1
                ],
                [
                    2,
                    3
                ]
