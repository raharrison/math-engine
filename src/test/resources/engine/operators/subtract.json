            "input": "([1, 2; 3, 4]) - (2.5d)",
            "expected": [
                [
                    -1.5,
                    -0.5
                ],
                [
                    0.5,
                    1.5
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Matrix subtracts a double"
        },
        {
            "id": "subtract_types_matrix_matrix",
            "input": "([1, 2; 3, 4]) - ([1, 2; 3, 4])",
            "expected": [
                [
                    0,
                    0
                ],
                [
                    0,
                    0
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Matrix subtracts a matrix"
        },
        {
            "id": "subtract_types_matrix_percent",
            "input": "([1, 2; 3, 4]) - (20%)",
            "expected": [
                [
                    0.8,
                    1.6
                ],
                [
                    2.4,
                    3.2
                ]
