            "expectedType": "NodeMatrix",
            "notes": "Matrix subtracts a percent"
        },
        {
            "id": "subtract_types_matrix_range",
            "input": "([1, 2; 3, 4]) - (1..2)",
            "expected": [
                [
                    0,
                    0
                ],
                [
                    2,
                    2
                ]
