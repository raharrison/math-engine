{
    "category": "Operator: != (inequality)",
    "description": "The complement of equality, held to the same type rules.",
    "tests": [
        {
            "id": "matrix_neq_001",
            "input": "[[1, 2], [3, 4]] != [[5, 6], [7, 8]]",
            "expected": true,
            "expectedType": "NodeBoolean",
            "notes": "Matrix not equal"
        },
        {
            "id": "neq_001",
            "input": "5 != 5",
            "expected": false,
            "expectedType": "NodeBoolean",
            "notes": "Inequality: equal values"
        },
        {
            "id": "neq_002",
            "input": "5 != 6",
            "expected": true,
            "expectedType": "NodeBoolean",
            "notes": "Inequality: unequal values"
        },
        {
            "id": "neq_003",
            "input": "0 != 1",
            "expected": true,
            "expectedType": "NodeBoolean",
            "notes": "Zero not equal to one"
        },
        {
            "id": "neq_004",
            "input": "-5 != 5",
            "expected": true,
            "expectedType": "NodeBoolean",
            "notes": "Negative not equal to positive"
        },
        {
