{
    "category": "Operator: + (addition)",
    "description": "Addition across every operand type it accepts: rationals, doubles, percents, units, strings, booleans, vectors and matrices.",
    "tests": [
        {
            "id": "add_001",
            "input": "1 + 2",
            "expected": 3,
            "expectedType": "NodeRational",
            "notes": "Integer addition stays rational"
        },
        {
            "id": "add_002",
            "input": "0 + 0",
            "expected": 0,
            "expectedType": "NodeRational",
            "notes": "Zero addition identity"
        },
        {
            "id": "add_003",
            "input": "-5 + 5",
            "expected": 0,
            "expectedType": "NodeRational",
            "notes": "Additive inverse"
        },
        {
            "id": "add_004",
            "input": "1 + 2 + 3 + 4 + 5",
            "expected": 15,
            "expectedType": "NodeRational",
            "notes": "Multiple additions"
        },
        {
            "id": "add_005",
            "input": "2.5 + 3.5",
            "expected": 6.0,
            "expectedType": "NodeRational",
            "notes": "Decimal addition"
        },
        {
            "id": "add_006",
            "input": "1e10 + 1e10",
            "expected": 20000000000.0,
            "expectedType": "NodeRational",
            "notes": "Large number addition"
        },
        {
            "id": "add_types_boolean_boolean",
            "input": "(true) + (true)",
            "expected": 2,
            "expectedType": "NodeRational",
            "notes": "Boolean adds a boolean"
        },
        {
            "id": "add_types_boolean_double",
            "input": "(true) + (2.5d)",
            "expected": 3.5,
            "expectedType": "NodeDouble",
            "notes": "Boolean adds a double"
        },
        {
            "id": "add_types_boolean_matrix",
            "input": "(true) + ([1, 2; 3, 4])",
            "expected": [
                [
                    2,
                    3
                ],
                [
                    4,
                    5
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Boolean adds a matrix"
        },
        {
            "id": "add_types_boolean_percent",
            "input": "(true) + (20%)",
            "expected": "6/5",
            "expectedType": "NodeRational",
            "notes": "Boolean adds a percent"
        },
        {
            "id": "add_types_boolean_range",
            "input": "(true) + (1..2)",
            "expected": [
                2,
                3
            ],
            "expectedType": "NodeVector",
            "notes": "Boolean adds a range"
        },
        {
            "id": "add_types_boolean_rational",
            "input": "(true) + (3)",
            "expected": 4,
            "expectedType": "NodeRational",
            "notes": "Boolean adds a rational"
        },
        {
            "id": "add_types_boolean_string",
            "input": "(true) + (\"ab\")",
            "expected": "trueab",
            "expectedType": "NodeString",
            "notes": "Boolean adds a string"
        },
        {
            "id": "add_types_boolean_unit",
            "input": "(true) + (4 meters)",
            "expected": "5.0 meters",
            "expectedType": "NodeUnit",
            "notes": "Boolean adds a unit"
        },
        {
            "id": "add_types_boolean_vector",
            "input": "(true) + ({1, 2})",
            "expected": [
                2,
                3
            ],
            "expectedType": "NodeVector",
            "notes": "Boolean adds a vector"
        },
        {
            "id": "add_types_double_boolean",
            "input": "(2.5d) + (true)",
            "expected": 3.5,
            "expectedType": "NodeDouble",
            "notes": "Double adds a boolean"
        },
        {
            "id": "add_types_double_double",
            "input": "(2.5d) + (2.5d)",
            "expected": 5.0,
            "expectedType": "NodeDouble",
            "notes": "Double adds a double"
        },
        {
