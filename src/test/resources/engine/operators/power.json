        },
        {
            "id": "power_types_percent_matrix",
            "input": "(20%) ^ ([1, 2; 3, 4])",
            "expected": [
                [
                    "20.0%",
                    "4.000000000000001%"
                ],
                [
                    "0.8000000000000002%",
                    "0.16000000000000003%"
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Percent raises a matrix"
        },
        {
            "id": "power_types_percent_percent",
            "input": "(20%) ^ (20%)",
            "expected": "72.47796636776955%",
            "expectedType": "NodePercent",
            "notes": "Percent raises a percent"
        },
        {
            "id": "power_types_percent_range",
            "input": "(20%) ^ (1..2)",
            "expected": [
                "20.0%",
                "4.000000000000001%"
            ],
            "expectedType": "NodeVector",
            "notes": "Percent raises a range"
        },
        {
            "id": "power_types_percent_rational",
            "input": "(20%) ^ (3)",
            "expected": "0.8000000000000002%",
            "expectedType": "NodePercent",
            "notes": "Percent raises a rational"
        },
        {
            "id": "power_types_percent_string",
            "input": "(20%) ^ (\"ab\")",
            "expectError": true,
            "expectedErrorType": "TypeError",
            "notes": "Percent raises a string is not defined"
        },
        {
            "id": "power_types_percent_unit",
            "input": "(20%) ^ (4 meters)",
            "expected": "0.0016 meters",
            "expectedType": "NodeUnit",
            "tolerance": 1e-12,
            "notes": "A percentage raised to a quantity keeps the quantity's label"
        },
        {
            "id": "power_types_percent_vector",
            "input": "(20%) ^ ({1, 2})",
            "expected": [
                "20.0%",
                "4.000000000000001%"
