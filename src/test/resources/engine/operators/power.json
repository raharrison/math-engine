        {
            "id": "power_types_vector_vector",
            "input": "({1, 2}) ^ ({1, 2})",
            "expected": [
                1,
                4
            ],
            "expectedType": "NodeVector",
            "notes": "Vector raises a vector"
        },
        {
            "id": "vector_018",
            "input": "{2, 3, 4} ^ 2",
            "expected": [
                4.0,
                9.0,
                16.0
            ],
            "expectedType": "NodeVector",
            "notes": "Element-wise power (promotes to double)"
        },
        {
            "id": "vector_power_002",
            "input": "{4, 9, 16} ^ 0.5",
            "expected": [
                2,
                3,
                4
            ],
            "expectedType": "NodeVector",
            "notes": "Vector square root"
        },
        {
            "id": "unit_first_power",
            "input": "(7 feet) ^ 1",
            "expected": "7.0 feet",
            "expectedType": "NodeUnit",
            "notes": "The first power leaves the magnitude alone as well as the label"
        },
        {
            "id": "unit_squared",
            "input": "(10 meters) ^ 2",
            "expected": "100.0 meters",
            "expectedType": "NodeUnit",
            "notes": "Squaring works on the magnitude and the label rides along; a label is not a claim about dimension"
        },
        {
            "id": "odd_root_of_a_negative",
            "input": "(-8) ^ (1/3)",
            "expected": -2.0,
            "expectedType": "NodeDouble",
            "tolerance": 1e-12,
            "notes": "An odd denominator has a real root, which Math.pow answers as NaN; cbrt already gave -2"
        },
        {
            "id": "even_root_of_a_negative",
            "input": "(-4) ^ (1/2)",
            "expected": "NaN",
            "expectedType": "NodeDouble",
            "notes": "An even denominator has no real root, so this stays NaN"
        },
        {
            "id": "exponent_above_exact_limit",
            "input": "2 ^ 100000",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "expectedErrorMessage": "exact arithmetic limit",
            "notes": "Falling back to a double answered Infinity for a number the engine declined to compute"
        },
        {
            "id": "huge_exponent_of_one",
            "input": "1 ^ 100000",
            "expected": 1,
            "expectedType": "NodeRational",
            "notes": "A base of 0, 1 or -1 is cheap at any exponent, so the limit does not apply"
        }
    ]
}
