{
    "category": "Operator: ^ (exponentiation)",
    "description": "Exponentiation across every operand type, including where an exact result is kept and where it is not.",
    "tests": [
        {
            "id": "matrix_power_001",
            "input": "[[1, 1], [1, 0]] ^ 2",
            "expected": [
                [
                    2,
                    1
                ],
                [
                    1,
                    1
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Matrix power (Fibonacci matrix squared)"
        },
        {
            "id": "matrix_power_001_power",
            "input": "[[2, 3], [4, 5]] ^ 2",
            "expected": [
                [
                    16,
                    21
                ],
                [
                    28,
                    37
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Matrix power (A^2 = A @ A)"
        },
        {
            "id": "matrix_power_002",
            "input": "[[1, 1], [1, 0]] ^ 5",
            "expected": [
                [
                    8,
                    5
                ],
                [
                    5,
                    3
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Fibonacci matrix to 5th power"
        },
        {
            "id": "matrix_power_003",
            "input": "[[2, 0], [0, 3]] ^ 0",
            "expected": [
                [
                    1,
                    0
                ],
                [
                    0,
                    1
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Matrix to power 0 gives identity"
        },
        {
            "id": "matrix_power_nonint_001",
            "input": "[[1, 2], [3, 4]] ^ 2.5",
            "expected": [
                [
                    1,
                    5.656854249492381
                ],
                [
                    15.588457268119896,
                    32
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Matrix power with non-integer: element-wise power (broadcasts)"
        },
        {
            "id": "pow_001",
            "input": "2^3",
            "expected": 8,
            "expectedType": "NodeRational",
            "notes": "Integer power"
        },
        {
            "id": "pow_002",
            "input": "2^0",
            "expected": 1,
            "expectedType": "NodeRational",
            "notes": "Anything to the power 0"
        },
        {
            "id": "pow_003",
            "input": "0^5",
            "expected": 0,
            "expectedType": "NodeRational",
            "notes": "Zero to positive power"
        },
        {
            "id": "pow_004",
            "input": "2^-1",
            "expected": 0.5,
            "expectedType": "NodeRational",
            "notes": "Negative exponent"
        },
        {
            "id": "pow_005",
            "input": "4^0.5",
            "expected": 2.0,
            "expectedType": "NodeDouble",
            "notes": "Fractional exponent (square root)"
        },
        {
            "id": "pow_006",
            "input": "8^(1/3)",
            "expected": 2.0,
            "expectedType": "NodeDouble",
            "notes": "Cube root via exponent"
        },
        {
            "id": "pow_010",
            "input": "(-2)^3",
            "expected": -8,
            "expectedType": "NodeRational",
            "notes": "Negative base cubed"
        },
        {
            "id": "power_types_boolean_boolean",
            "input": "(true) ^ (true)",
            "expected": 1,
            "expectedType": "NodeRational",
            "notes": "Boolean raises a boolean"
        },
        {
            "id": "power_types_boolean_double",
            "input": "(true) ^ (2.5d)",
            "expected": 1.0,
            "expectedType": "NodeDouble",
            "notes": "Boolean raises a double"
        },
        {
            "id": "power_types_boolean_matrix",
            "input": "(true) ^ ([1, 2; 3, 4])",
            "expected": [
                [
                    1,
                    1
                ],
                [
                    1,
                    1
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Boolean raises a matrix"
        },
        {
            "id": "power_types_boolean_percent",
            "input": "(true) ^ (20%)",
            "expected": 1.0,
            "expectedType": "NodeDouble",
            "notes": "Boolean raises a percent"
        },
        {
            "id": "power_types_boolean_range",
            "input": "(true) ^ (1..2)",
            "expected": [
                1,
                1
            ],
            "expectedType": "NodeVector",
            "notes": "Boolean raises a range"
        },
        {
            "id": "power_types_boolean_rational",
            "input": "(true) ^ (3)",
            "expected": 1,
            "expectedType": "NodeRational",
            "notes": "Boolean raises a rational"
        },
        {
            "id": "power_types_boolean_string",
            "input": "(true) ^ (\"ab\")",
            "expectError": true,
            "expectedErrorType": "TypeError",
            "notes": "Boolean raises a string is not defined"
        },
        {
            "id": "power_types_boolean_unit",
            "input": "(true) ^ (4 meters)",
            "expected": "1.0 meter",
            "expectedType": "NodeUnit",
            "notes": "A boolean raised to a quantity keeps the label"
        },
        {
            "id": "power_types_boolean_vector",
            "input": "(true) ^ ({1, 2})",
            "expected": [
                1,
                1
            ],
            "expectedType": "NodeVector",
            "notes": "Boolean raises a vector"
        },
        {
            "id": "power_types_double_boolean",
            "input": "(2.5d) ^ (true)",
            "expected": 2.5,
            "expectedType": "NodeDouble",
            "notes": "Double raises a boolean"
        },
        {
            "id": "power_types_double_double",
            "input": "(2.5d) ^ (2.5d)",
            "expected": 9.882117688026186,
            "expectedType": "NodeDouble",
            "notes": "Double raises a double"
        },
        {
            "id": "power_types_double_matrix",
            "input": "(2.5d) ^ ([1, 2; 3, 4])",
            "expected": [
                [
                    2.5,
                    6.25
                ],
                [
                    15.625,
                    39.0625
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Double raises a matrix"
        },
        {
            "id": "power_types_double_percent",
            "input": "(2.5d) ^ (20%)",
            "expected": 1.2011244339814313,
            "expectedType": "NodeDouble",
            "notes": "Double raises a percent"
        },
        {
            "id": "power_types_double_range",
            "input": "(2.5d) ^ (1..2)",
            "expected": [
                2.5,
                6.25
            ],
            "expectedType": "NodeVector",
            "notes": "Double raises a range"
        },
        {
            "id": "power_types_double_rational",
            "input": "(2.5d) ^ (3)",
            "expected": 15.625,
            "expectedType": "NodeDouble",
            "notes": "Double raises a rational"
        },
        {
            "id": "power_types_double_string",
            "input": "(2.5d) ^ (\"ab\")",
            "expectError": true,
            "expectedErrorType": "TypeError",
            "notes": "Double raises a string is not defined"
        },
        {
            "id": "power_types_double_unit",
            "input": "(2.5d) ^ (4 meters)",
            "expected": "39.0625 meters",
            "expectedType": "NodeUnit",
            "notes": "A double raised to a quantity keeps the label"
        },
        {
            "id": "power_types_double_vector",
            "input": "(2.5d) ^ ({1, 2})",
            "expected": [
                2.5,
                6.25
            ],
            "expectedType": "NodeVector",
            "notes": "Double raises a vector"
        },
        {
            "id": "power_types_matrix_boolean",
            "input": "([1, 2; 3, 4]) ^ (true)",
            "expected": [
                [
                    1,
                    2
                ],
                [
                    3,
                    4
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Matrix raises a boolean"
        },
        {
            "id": "power_types_matrix_double",
            "input": "([1, 2; 3, 4]) ^ (2.5d)",
            "expected": [
                [
                    1.0,
                    5.656854249492381
                ],
                [
                    15.588457268119896,
                    32.0
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Matrix raises a double"
        },
        {
            "id": "power_types_matrix_matrix",
            "input": "([1, 2; 3, 4]) ^ ([1, 2; 3, 4])",
            "expected": [
                [
                    1,
                    4
                ],
                [
                    27,
                    256
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Matrix raises a matrix"
        },
        {
            "id": "power_types_matrix_percent",
            "input": "([1, 2; 3, 4]) ^ (20%)",
            "expected": [
                [
                    1.0,
                    1.148698354997035
                ],
                [
                    1.2457309396155174,
                    1.3195079107728942
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Matrix raises a percent"
        },
        {
            "id": "power_types_matrix_range",
            "input": "([1, 2; 3, 4]) ^ (1..2)",
            "expected": [
                [
                    1,
                    4
                ],
                [
                    3,
                    16
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Matrix raises a range"
        },
        {
            "id": "power_types_matrix_rational",
            "input": "([1, 2; 3, 4]) ^ (3)",
            "expected": [
                [
                    37,
                    54
                ],
                [
                    81,
                    118
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Matrix raises a rational"
        },
        {
            "id": "power_types_matrix_string",
            "input": "([1, 2; 3, 4]) ^ (\"ab\")",
            "expectError": true,
            "expectedErrorType": "TypeError",
            "notes": "Matrix raises a string is not defined"
        },
        {
            "id": "power_types_matrix_unit",
            "input": "([1, 2; 3, 4]) ^ (4 meters)",
            "expected": [
                [
                    "1.0 meter",
                    "16.0 meters"
                ],
                [
                    "81.0 meters",
                    "256.0 meters"
