{
    "category": "Operator: <= (less than or equal)",
    "description": "Ordering with equality across numbers, strings and units.",
    "tests": [
        {
            "id": "float_002_less_or_equal",
            "input": "1.5 <= 1.5",
            "expected": true,
            "expectedType": "NodeBoolean",
            "notes": "Decimal less than or equal"
        },
        {
            "id": "less_or_equal_types_boolean_boolean",
            "input": "(true) <= (true)",
            "expected": true,
            "expectedType": "NodeBoolean",
            "notes": "Boolean orders a boolean"
        },
        {
            "id": "less_or_equal_types_boolean_double",
            "input": "(true) <= (2.5d)",
            "expected": true,
            "expectedType": "NodeBoolean",
            "notes": "Boolean orders a double"
        },
        {
            "id": "less_or_equal_types_boolean_matrix",
            "input": "(true) <= ([1, 2; 3, 4])",
            "expectError": true,
            "expectedErrorType": "TypeError",
            "notes": "Boolean orders a matrix is not defined"
        },
        {
            "id": "less_or_equal_types_boolean_percent",
            "input": "(true) <= (20%)",
            "expected": false,
            "expectedType": "NodeBoolean",
            "notes": "Boolean orders a percent"
        },
        {
            "id": "less_or_equal_types_boolean_range",
            "input": "(true) <= (1..2)",
            "expectError": true,
            "expectedErrorType": "TypeError",
            "notes": "Boolean orders a range is not defined"
        },
        {
            "id": "less_or_equal_types_boolean_rational",
            "input": "(true) <= (3)",
            "expected": true,
            "expectedType": "NodeBoolean",
            "notes": "Boolean orders a rational"
        },
        {
            "id": "less_or_equal_types_boolean_string",
            "input": "(true) <= (\"ab\")",
            "expectError": true,
            "expectedErrorType": "TypeError",
            "notes": "Boolean orders a string is not defined"
        },
        {
            "id": "less_or_equal_types_boolean_unit",
            "input": "(true) <= (4 meters)",
            "expected": true,
            "expectedType": "NodeBoolean",
            "notes": "Boolean orders a unit"
        },
