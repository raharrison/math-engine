            ],
            "expectedType": "NodeVector",
            "notes": "Vector multiplies a string"
        },
        {
            "id": "multiply_types_vector_unit",
            "input": "({1, 2}) * (4 meters)",
            "expected": [
                "4.0 meters",
                "8.0 meters"
            ],
            "expectedType": "NodeVector",
            "notes": "Vector multiplies a unit"
        },
        {
            "id": "multiply_types_vector_vector",
            "input": "({1, 2}) * ({1, 2})",
            "expected": [
                1,
                4
            ],
            "expectedType": "NodeVector",
            "notes": "Vector multiplies a vector"
        },
        {
            "id": "vector_006",
            "input": "{1, 2} * {3, 4}",
            "expected": [
                3,
                8
            ],
            "expectedType": "NodeVector",
            "notes": "Element-wise multiplication (Hadamard product)"
        },
        {
            "id": "vector_008",
            "input": "{1, 2, 3} * 2",
            "expected": [
                2,
                4,
                6
            ],
            "expectedType": "NodeVector",
            "notes": "Scalar multiplication (vector * scalar)"
        },
        {
            "id": "vector_009",
            "input": "2 * {1, 2, 3}",
            "expected": [
                2,
                4,
                6
            ],
            "expectedType": "NodeVector",
            "notes": "Scalar multiplication (scalar * vector)"
        },
        {
            "id": "vector_mult_001",
            "input": "{1, 2, 3} * {4, 5, 6}",
            "expected": [
                4,
                10,
                18
            ],
            "expectedType": "NodeVector",
            "notes": "Element-wise multiplication"
        },
        {
            "id": "vector_mult_003",
            "input": "3 * {1, 2, 3}",
            "expected": [
                3,
                6,
                9
            ],
            "expectedType": "NodeVector",
            "notes": "Scalar multiplication (reversed)"
        },
        {
            "id": "fractional_count",
            "input": "\"ab\" * 2.5",
            "expectError": true,
            "expectedErrorType": "TypeError",
            "expectedErrorMessage": "fractional",
            "notes": "A fractional count is refused rather than rounded down to 'abab'"
        },
        {
            "id": "percent_count",
            "input": "20% * \"ab\"",
            "expectError": true,
            "expectedErrorType": "TypeError",
            "notes": "A percentage is a fractional count, so it fails the same way rather than repeating zero times"
        },
        {
            "id": "quantity_count",
            "input": "(4 meters) * \"ab\"",
            "expectError": true,
            "expectedErrorType": "TypeError",
            "notes": "Repeating a string four metres times means nothing"
        },
        {
            "id": "whole_count",
            "input": "\"ab\" * 4",
            "expected": "abababab",
            "expectedType": "NodeString",
            "notes": "A whole count still works"
        },
        {
            "id": "unit_times_unit",
            "input": "(4 meters) * (2 meters)",
            "notes": "Two like quantities multiply, converting to the left operand's unit first, as addition does",
            "expected": "8.0 meters",
            "expectedType": "NodeUnit"
        },
        {
            "id": "percent_on_the_right_measures",
            "input": "100 * 10%",
            "expected": 10,
            "expectedType": "NodeRational",
            "tolerance": 1e-12,
            "notes": "A percent on the right is read against the number on its left, so this is the amount 10, agreeing with 10% of 100"
        },
        {
            "id": "percent_on_the_left_scales",
            "input": "10% * 5",
            "expected": "50%",
            "expectedType": "NodePercent",
            "tolerance": 1e-12,
            "notes": "A percent on the left is the thing being scaled, so it stays a percentage"
        }
    ]
}
