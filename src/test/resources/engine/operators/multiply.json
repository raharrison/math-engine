{
    "category": "Operator: * (multiplication)",
    "description": "Multiplication across every operand type, including string repetition and element-wise collection products.",
    "tests": [
        {
            "id": "matrix_007",
            "input": "[1, 2; 3, 4] * 2",
            "expected": [
                [
                    2,
                    4
                ],
                [
                    6,
                    8
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Scalar multiplication"
        },
        {
            "id": "matrix_008",
            "input": "2 * [1, 2; 3, 4]",
            "expected": [
                [
                    2,
                    4
                ],
                [
                    6,
                    8
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Scalar multiplication (reversed)"
        },
        {
            "id": "matrix_015",
            "input": "[1, 2; 3, 4] * [2, 3; 4, 5]",
            "expected": [
                [
                    2,
                    6
                ],
                [
                    12,
                    20
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Element-wise multiplication (Hadamard), NOT matrix multiply"
        },
        {
            "id": "matrix_elementwise_001",
            "input": "[[1, 2], [3, 4]] * [[5, 6], [7, 8]]",
            "expected": [
                [
                    5,
                    12
                ],
                [
                    21,
                    32
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Element-wise multiplication with *"
        },
        {
            "id": "matrix_mult_003",
            "input": "3 * [[1, 2], [3, 4]]",
            "expected": [
                [
                    3,
                    6
                ],
                [
                    9,
                    12
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Scalar multiplication (reversed)"
        },
        {
            "id": "matrix_scalar_001",
            "input": "2 * [[1, 2], [3, 4]]",
            "expected": [
                [
                    2,
                    4
                ],
                [
                    6,
                    8
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Scalar multiplication"
        },
        {
            "id": "mul_002",
            "input": "0 * 1000",
            "expected": 0,
            "expectedType": "NodeRational",
            "notes": "Multiplication by zero"
        },
        {
            "id": "mul_003",
            "input": "1 * 42",
            "expected": 42,
            "expectedType": "NodeRational",
            "notes": "Multiplicative identity"
        },
        {
            "id": "mul_004",
            "input": "-3 * 4",
            "expected": -12,
            "expectedType": "NodeRational",
            "notes": "Negative times positive"
        },
        {
            "id": "mul_005",
            "input": "-3 * -4",
            "expected": 12,
            "expectedType": "NodeRational",
            "notes": "Negative times negative"
        },
        {
            "id": "mul_007",
            "input": "2.5 * 4",
            "expected": 10.0,
            "expectedType": "NodeRational",
            "notes": "Decimal multiplication"
        },
        {
            "id": "multiply_types_boolean_boolean",
            "input": "(true) * (true)",
            "expected": 1,
            "expectedType": "NodeRational",
            "notes": "Boolean multiplies a boolean"
        },
        {
            "id": "multiply_types_boolean_double",
            "input": "(true) * (2.5d)",
            "expected": 2.5,
            "expectedType": "NodeDouble",
            "notes": "Boolean multiplies a double"
        },
        {
            "id": "multiply_types_boolean_matrix",
            "input": "(true) * ([1, 2; 3, 4])",
            "expected": [
                [
                    1,
                    2
                ],
                [
                    3,
                    4
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Boolean multiplies a matrix"
        },
        {
            "id": "multiply_types_boolean_percent",
            "input": "(true) * (20%)",
            "expected": "1/5",
            "expectedType": "NodeRational",
            "tolerance": 1e-12,
            "notes": "A percent on the right measures the number on its left, so the answer is an amount"
        },
        {
            "id": "multiply_types_boolean_range",
            "input": "(true) * (1..2)",
            "expected": [
                1,
                2
            ],
            "expectedType": "NodeVector",
            "notes": "Boolean multiplies a range"
        },
        {
            "id": "multiply_types_boolean_rational",
            "input": "(true) * (3)",
            "expected": 3,
            "expectedType": "NodeRational",
            "notes": "Boolean multiplies a rational"
        },
        {
            "id": "multiply_types_boolean_string",
            "input": "(true) * (\"ab\")",
            "expected": "ab",
            "expectedType": "NodeString",
            "notes": "Boolean multiplies a string"
        },
        {
            "id": "multiply_types_boolean_unit",
            "input": "(true) * (4 meters)",
            "expected": "4.0 meters",
            "expectedType": "NodeUnit",
            "notes": "Boolean multiplies a unit"
        },
        {
            "id": "multiply_types_boolean_vector",
            "input": "(true) * ({1, 2})",
            "expected": [
                1,
                2
            ],
            "expectedType": "NodeVector",
            "notes": "Boolean multiplies a vector"
        },
        {
            "id": "multiply_types_double_boolean",
            "input": "(2.5d) * (true)",
            "expected": 2.5,
            "expectedType": "NodeDouble",
            "notes": "Double multiplies a boolean"
        },
        {
            "id": "multiply_types_double_double",
            "input": "(2.5d) * (2.5d)",
            "expected": 6.25,
            "expectedType": "NodeDouble",
            "notes": "Double multiplies a double"
        },
        {
            "id": "multiply_types_double_matrix",
            "input": "(2.5d) * ([1, 2; 3, 4])",
            "expected": [
                [
                    2.5,
                    5.0
                ],
                [
                    7.5,
                    10.0
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Double multiplies a matrix"
        },
        {
            "id": "multiply_types_double_percent",
            "input": "(2.5d) * (20%)",
            "expected": 0.5,
            "expectedType": "NodeDouble",
            "tolerance": 1e-12,
            "notes": "A double times a percent is the share of that double"
        },
        {
            "id": "multiply_types_double_range",
            "input": "(2.5d) * (1..2)",
            "expected": [
                2.5,
                5.0
            ],
            "expectedType": "NodeVector",
            "notes": "Double multiplies a range"
        },
        {
            "id": "multiply_types_double_rational",
            "input": "(2.5d) * (3)",
            "expected": 7.5,
            "expectedType": "NodeDouble",
            "notes": "Double multiplies a rational"
        },
        {
            "id": "multiply_types_double_string",
            "input": "(2.5d) * (\"ab\")",
            "expectError": true,
            "expectedErrorType": "TypeError",
            "notes": "Double multiplies a string is not defined"
        },
        {
            "id": "multiply_types_double_unit",
            "input": "(2.5d) * (4 meters)",
            "expected": "10.0 meters",
            "expectedType": "NodeUnit",
            "notes": "Double multiplies a unit"
        },
        {
            "id": "multiply_types_double_vector",
            "input": "(2.5d) * ({1, 2})",
            "expected": [
                2.5,
                5.0
            ],
            "expectedType": "NodeVector",
            "notes": "Double multiplies a vector"
        },
        {
            "id": "multiply_types_matrix_boolean",
            "input": "([1, 2; 3, 4]) * (true)",
            "expected": [
                [
                    1,
                    2
                ],
                [
                    3,
                    4
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Matrix multiplies a boolean"
        },
        {
            "id": "multiply_types_matrix_double",
            "input": "([1, 2; 3, 4]) * (2.5d)",
            "expected": [
                [
                    2.5,
                    5.0
                ],
                [
                    7.5,
                    10.0
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Matrix multiplies a double"
        },
        {
            "id": "multiply_types_matrix_matrix",
            "input": "([1, 2; 3, 4]) * ([1, 2; 3, 4])",
            "expected": [
                [
                    1,
                    4
                ],
                [
                    9,
                    16
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Matrix multiplies a matrix"
        },
        {
            "id": "multiply_types_matrix_percent",
            "input": "([1, 2; 3, 4]) * (20%)",
            "expected": [
                [
                    0.2,
                    0.4
                ],
                [
                    0.6,
                    0.8
                ]
            ],
            "expectedType": "NodeMatrix",
            "tolerance": 1e-12,
            "notes": "Broadcasting takes the share of each element"
        },
        {
            "id": "multiply_types_matrix_range",
            "input": "([1, 2; 3, 4]) * (1..2)",
            "expected": [
                [
                    1,
                    4
                ],
                [
                    3,
                    8
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Matrix multiplies a range"
        },
        {
            "id": "multiply_types_matrix_rational",
            "input": "([1, 2; 3, 4]) * (3)",
            "expected": [
                [
                    3,
                    6
                ],
                [
                    9,
                    12
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Matrix multiplies a rational"
        },
        {
            "id": "multiply_types_matrix_string",
            "input": "([1, 2; 3, 4]) * (\"ab\")",
            "expected": [
                [
                    "ab",
                    "abab"
                ],
                [
                    "ababab",
                    "abababab"
                ]
