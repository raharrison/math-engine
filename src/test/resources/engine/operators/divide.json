{
    "category": "Operator: / (division)",
    "description": "Division across every operand type, including the cases where a unit cancels and where exactness is lost.",
    "tests": [
        {
            "id": "div_003",
            "input": "0 / 5",
            "expected": 0,
            "expectedType": "NodeRational",
            "notes": "Zero divided by non-zero"
        },
        {
            "id": "div_005",
            "input": "-12 / 4",
            "expected": -3,
            "expectedType": "NodeRational",
            "notes": "Negative dividend"
        },
        {
            "id": "div_006",
            "input": "12 / -4",
            "expected": -3,
            "expectedType": "NodeRational",
            "notes": "Negative divisor"
        },
        {
            "id": "div_007",
            "input": "-12 / -4",
            "expected": 3,
            "expectedType": "NodeRational",
            "notes": "Both negative"
        },
        {
            "id": "divide_types_boolean_boolean",
            "input": "(true) / (true)",
            "expected": 1,
            "expectedType": "NodeRational",
            "notes": "Boolean divides a boolean"
        },
        {
            "id": "divide_types_boolean_double",
            "input": "(true) / (2.5d)",
            "expected": 0.4,
            "expectedType": "NodeDouble",
            "notes": "Boolean divides a double"
        },
        {
            "id": "divide_types_boolean_matrix",
            "input": "(true) / ([1, 2; 3, 4])",
            "expected": [
                [
                    1,
                    "1/2"
                ],
                [
                    "1/3",
                    "1/4"
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Boolean divides a matrix"
        },
        {
            "id": "divide_types_boolean_percent",
            "input": "(true) / (20%)",
            "expected": 5,
            "expectedType": "NodeRational",
            "notes": "Boolean divides a percent"
        },
        {
            "id": "divide_types_boolean_range",
            "input": "(true) / (1..2)",
            "expected": [
                1,
                "1/2"
            ],
            "expectedType": "NodeVector",
            "notes": "Boolean divides a range"
        },
        {
            "id": "divide_types_boolean_rational",
            "input": "(true) / (3)",
            "expected": "1/3",
            "expectedType": "NodeRational",
            "notes": "Boolean divides a rational"
        },
        {
            "id": "divide_types_boolean_string",
            "input": "(true) / (\"ab\")",
            "expectError": true,
            "expectedErrorType": "TypeError",
            "notes": "Boolean divides a string is not defined"
        },
        {
            "id": "divide_types_boolean_unit",
            "input": "(true) / (4 meters)",
            "expected": "0.25 meters",
            "expectedType": "NodeUnit",
            "notes": "A boolean over a quantity divides the magnitude and keeps the label"
        },
        {
            "id": "divide_types_boolean_vector",
            "input": "(true) / ({1, 2})",
            "expected": [
                1,
                "1/2"
            ],
            "expectedType": "NodeVector",
            "notes": "Boolean divides a vector"
        },
        {
            "id": "divide_types_double_boolean",
            "input": "(2.5d) / (true)",
            "expected": 2.5,
            "expectedType": "NodeDouble",
            "notes": "Double divides a boolean"
        },
        {
            "id": "divide_types_double_double",
            "input": "(2.5d) / (2.5d)",
            "expected": 1.0,
            "expectedType": "NodeDouble",
            "notes": "Double divides a double"
        },
        {
            "id": "divide_types_double_matrix",
            "input": "(2.5d) / ([1, 2; 3, 4])",
            "expected": [
                [
                    2.5,
                    1.25
                ],
                [
                    0.8333333333333334,
                    0.625
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Double divides a matrix"
        },
        {
            "id": "divide_types_double_percent",
            "input": "(2.5d) / (20%)",
            "expected": 12.5,
            "expectedType": "NodeDouble",
            "notes": "Double divides a percent"
        },
        {
            "id": "divide_types_double_range",
            "input": "(2.5d) / (1..2)",
            "expected": [
                2.5,
                1.25
            ],
            "expectedType": "NodeVector",
            "notes": "Double divides a range"
        },
        {
            "id": "divide_types_double_rational",
            "input": "(2.5d) / (3)",
            "expected": 0.8333333333333334,
            "expectedType": "NodeDouble",
            "notes": "Double divides a rational"
        },
        {
            "id": "divide_types_double_string",
            "input": "(2.5d) / (\"ab\")",
            "expectError": true,
            "expectedErrorType": "TypeError",
            "notes": "Double divides a string is not defined"
        },
        {
            "id": "divide_types_double_unit",
            "input": "(2.5d) / (4 meters)",
            "expected": "0.625 meters",
            "expectedType": "NodeUnit",
            "notes": "A double over a quantity divides the magnitude and keeps the label"
        },
        {
            "id": "divide_types_double_vector",
            "input": "(2.5d) / ({1, 2})",
            "expected": [
                2.5,
                1.25
            ],
            "expectedType": "NodeVector",
            "notes": "Double divides a vector"
        },
        {
            "id": "divide_types_matrix_boolean",
            "input": "([1, 2; 3, 4]) / (true)",
            "expected": [
                [
                    1,
                    2
                ],
                [
                    3,
                    4
                ]
            ],
            "expectedType": "NodeMatrix",
            "notes": "Matrix divides a boolean"
        },
