{
    "category": "Operator: == (equality)",
    "description": "Value equality across every type, including unit conversion, structural comparison of collections, and NaN.",
    "tests": [
        {
            "id": "boolean_eq_001",
            "input": "true == (5 > 3)",
            "expected": true,
            "expectedType": "NodeBoolean",
            "notes": "Boolean literal equals comparison result"
        },
        {
            "id": "boolean_eq_002",
            "input": "(2 + 2 == 4) == true",
            "expected": true,
            "expectedType": "NodeBoolean",
            "notes": "Nested boolean comparison"
        },
        {
            "id": "chain_001",
            "input": "(5 > 3) == true",
            "expected": true,
            "expectedType": "NodeBoolean",
            "notes": "Compare comparison result to boolean"
        },
        {
            "id": "chain_002",
            "input": "(5 < 3) == false",
            "expected": true,
            "expectedType": "NodeBoolean",
            "notes": "False comparison equals false"
        },
        {
            "id": "complex_eq_001",
            "input": "(2 + 3) == (10 / 2)",
            "expected": true,
            "expectedType": "NodeBoolean",
            "notes": "Expression equality"
        },
        {
            "id": "complex_eq_002",
            "input": "abs(-5) == sqrt(25)",
            "expected": true,
            "expectedType": "NodeBoolean",
            "notes": "Function result equality"
        },
        {
            "id": "empty_eq_002",
            "input": "{} == {1}",
            "expected": false,
            "expectedType": "NodeBoolean",
            "notes": "Empty not equal to non-empty"
        },
        {
            "id": "eq_001",
            "input": "5 == 5",
            "expected": true,
            "expectedType": "NodeBoolean",
            "notes": "Equality: equal values"
        },
        {
            "id": "eq_002",
            "input": "5 == 6",
            "expected": false,
            "expectedType": "NodeBoolean",
            "notes": "Equality: unequal values"
        },
        {
            "id": "eq_003",
            "input": "0 == 0",
            "expected": true,
            "expectedType": "NodeBoolean",
            "notes": "Zero equality"
        },
        {
            "id": "eq_004",
            "input": "-5 == -5",
            "expected": true,
            "expectedType": "NodeBoolean",
            "notes": "Negative number equality"
        },
        {
            "id": "eq_005",
            "input": "5 == 5.0",
            "expected": true,
            "expectedType": "NodeBoolean",
            "notes": "Integer equals double with same value"
        },
        {
            "id": "eq_006",
            "input": "true == true",
            "expected": true,
            "expectedType": "NodeBoolean",
            "notes": "Boolean equality"
        },
        {
            "id": "eq_007",
            "input": "true == false",
            "expected": false,
            "expectedType": "NodeBoolean",
            "notes": "Boolean inequality"
        },
        {
            "id": "equal_types_boolean_boolean",
            "input": "(true) == (true)",
            "expected": true,
            "expectedType": "NodeBoolean",
            "notes": "Boolean compares a boolean"
        },
