{
    "category": "Errors: DomainException",
    "description": "Arguments outside a function's mathematical domain, where the function exists and the types are right but the value is not.",
    "tests": [
        {
            "id": "acos_domain_001",
            "input": "acos(-2)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "notes": "arccos outside [-1, 1]"
        },
        {
            "id": "acos_outofrange_001",
            "input": "acos(2)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "notes": "acos requires input in range [-1,1]"
        },
        {
            "id": "acosh_domain_001",
            "input": "acosh(0.5)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "notes": "acosh requires x >= 1, reported like every other domain error",
            "expectedErrorMessage": "x >= 1"
        },
        {
            "id": "acoth_domain_001",
            "input": "acoth(1)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "notes": "acoth is atanh(1/x), so it needs |x| > 1",
            "expectedErrorMessage": "|x| > 1"
        },
        {
            "id": "acsc_domain_001",
            "input": "acsc(0)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "notes": "acsc is asin(1/x), so it needs |x| >= 1",
            "expectedErrorMessage": "|x| >= 1"
        },
        {
            "id": "acsch_domain_001",
            "input": "acsch(0)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "notes": "acsch is asinh(1/x), which has no value at zero",
            "expectedErrorMessage": "undefined for x = 0"
        },
        {
            "id": "asec_domain_001",
            "input": "asec(0.5)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "notes": "asec is acos(1/x), so it needs |x| >= 1",
            "expectedErrorMessage": "|x| >= 1"
        },
        {
            "id": "asech_domain_001",
            "input": "asech(2)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "notes": "asech is acosh(1/x), so it needs 0 < x <= 1",
            "expectedErrorMessage": "0 < x <= 1"
        },
        {
            "id": "asin_outofrange_001",
            "input": "asin(2)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "notes": "asin requires input in range [-1,1]"
        },
        {
            "id": "atanh_domain_001",
            "input": "atanh(2)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "notes": "atanh requires |x| < 1, reported like every other domain error",
            "expectedErrorMessage": "|x| < 1"
        },
        {
            "id": "col_outofbounds_001",
            "input": "col([[1, 2], [3, 4]], 5)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "notes": "Column index out of bounds"
        },
        {
            "id": "correlation_length_001",
            "input": "correlation({1, 2, 3}, {1, 2})",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "notes": "Correlation requires equal length vectors"
        },
        {
            "id": "cot_at_a_pole",
            "input": "cot(0)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "notes": "A pole of the function is a domain error like any other",
            "expectedErrorMessage": "tan(x) = 0"
        },
        {
            "id": "coth_at_zero",
            "input": "coth(0)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "notes": "coth is 1/tanh, which has no value at zero",
            "expectedErrorMessage": "undefined for x = 0"
        },
        {
            "id": "covariance_length_001",
            "input": "covariance({1, 2, 3}, {1, 2})",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "notes": "Covariance requires equal length vectors"
        },
        {
            "id": "det_nonsquare_001",
            "input": "det([[1, 2, 3], [4, 5, 6]])",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "notes": "Determinant requires square matrix"
        },
        {
            "id": "doublefactorial_negative_001",
            "input": "(-3)!!",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "notes": "Double factorial of negative number"
        },
        {
            "id": "err_eval_004",
            "input": "ln(0)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "notes": "Logarithm of zero"
        },
        {
            "id": "err_eval_005",
            "input": "ln(-5)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "notes": "Logarithm of negative number"
        },
        {
            "id": "err_eval_013",
            "input": "(-10)!",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "notes": "Factorial of negative number"
        },
        {
            "id": "factorial_negative_001",
            "input": "factorial(-3)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "notes": "Factorial of negative integer"
        },
        {
            "id": "factorial_negative_001_domain_exception",
            "input": "(-5)!",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "notes": "Factorial of negative number"
        },
        {
            "id": "identity_negative_001",
            "input": "identity(-1)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "notes": "Identity size must be positive"
        },
        {
            "id": "identity_nonpositive_001",
            "input": "identity(0)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "notes": "Identity size must be positive"
        },
        {
            "id": "inverse_singular_001",
            "input": "inverse([[1, 2], [2, 4]])",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "expectedErrorMessage": "singular",
            "notes": "A singular matrix has no inverse, which is a domain problem rather than a bad argument"
        },
        {
            "id": "inverselerp_equal_001",
            "input": "inverselerp(5, 5, 3)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "notes": "Inverse lerp with equal start and end"
        },
        {
            "id": "log_negative_001",
            "input": "ln(-1)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "notes": "Log of negative"
        },
        {
            "id": "log_negative_001_domain_exception",
            "input": "log(-1)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "notes": "log is not defined for negative values"
        },
        {
            "id": "log_zero_001",
            "input": "log(0)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "notes": "log is not defined for zero"
        },
        {
            "id": "normalize_equal_001",
            "input": "normalize(5, 10, 10)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "notes": "Normalize with equal min and max"
        },
        {
            "id": "nroot_even_negative_001",
            "input": "nroot(-8, 2)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "notes": "Even root of negative"
        },
        {
            "id": "percentchange_zero_001",
            "input": "percentchange(0, 100)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "notes": "Percent change from zero"
        },
        {
            "id": "reshape_mismatch_001",
            "input": "reshape({1, 2, 3, 4, 5}, 2, 3)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "notes": "Cannot reshape 5 elements to 2x3"
        },
        {
            "id": "row_outofbounds_001",
            "input": "row([[1, 2], [3, 4]], 5)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "notes": "Row index out of bounds"
        },
        {
            "id": "sqrt_negative_001",
            "input": "sqrt(-1)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "notes": "Square root of negative (without complex)"
        },
        {
            "id": "tomatrix_flat_vector",
            "input": "tomatrix({1, 2, 3})",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "expectedErrorMessage": "not a vector",
            "notes": "tomatrix takes a vector of rows, so a flat vector is rejected rather than guessed at"
        },
        {
            "id": "trace_nonsquare_001",
            "input": "trace([[1, 2, 3], [4, 5, 6]])",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "notes": "Trace requires square matrix"
        },
        {
            "id": "whatpercent_zero_001",
            "input": "whatpercent(10, 0)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "notes": "What percent of zero"
        },
        {
            "id": "zeros_negative_001",
            "input": "zeros(-2)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "notes": "Zeros dimensions must be positive"
        },
        {
            "id": "frombase_invalid_digit",
            "input": "frombase(\"12\", 2)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "expectedErrorMessage": "not a base 2 integer",
            "notes": "2 is not a binary digit"
        },
        {
            "id": "tobase_base_too_small",
            "input": "tobase(5, 1)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "expectedErrorMessage": "between 2 and 36",
            "notes": "There is no base 1 positional notation"
        },
        {
            "id": "sigfig_zero_figures",
            "input": "sigfig(5, 0)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "expectedErrorMessage": "at least 1 significant figure",
            "notes": "Rounding to no significant figures has no meaning"
        },
        {
            "id": "isqrt_negative",
            "input": "isqrt(-1)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "expectedErrorMessage": "non-negative",
            "notes": "No real square root"
        },
        {
            "id": "digits_base_one",
            "input": "digits(10, 1)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "expectedErrorMessage": "at least 2",
            "notes": "Base 1 has no digits"
        },
        {
            "id": "irr_no_outflow",
            "input": "irr({100, 200})",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "expectedErrorMessage": "one payment in and one out",
            "notes": "Without money both in and out no rate can balance the flows"
        },
        {
            "id": "pmt_rate_total_loss",
            "input": "pmt(-150%, 10, 100)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "expectedErrorMessage": "greater than -100%",
            "notes": "Losing more than everything each period is not a rate"
        },
        {
            "id": "solve_no_sign_change",
            "input": "solve(x -> x^2 + 1, -1, 1)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "expectedErrorMessage": "do not bracket a root",
            "notes": "Brent's method needs the function to change sign between the bounds"
        },
        {
            "id": "deriv_order_too_high",
            "input": "deriv(x -> x, 0, 5)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "expectedErrorMessage": "between 1 and 4",
            "notes": "Only the first four derivatives are available"
        },
        {
            "id": "integrate_through_pole",
            "input": "integrate(x -> 1/x, -1, 1)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "expectedErrorMessage": "non-finite",
            "notes": "The integrand is infinite at zero, so the integral does not exist"
        },
        {
            "id": "normcdf_mean_without_sd",
            "input": "normcdf(1, 0)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "expectedErrorMessage": "or neither",
            "notes": "A mean alone does not define a normal distribution"
        },
        {
            "id": "normcdf_negative_sd",
            "input": "normcdf(1, 0, -1)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "expectedErrorMessage": "positive",
            "notes": "A standard deviation must be positive"
        },
        {
            "id": "norminv_probability_above_one",
            "input": "norminv(1.5)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "expectedErrorMessage": "(0, 1)",
            "notes": "A probability is between 0 and 1"
        },
        {
            "id": "binompdf_probability_above_one",
            "input": "binompdf(10, 1.5, 5)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "expectedErrorMessage": "(0, 1)",
            "notes": "A trial's probability of success is between 0 and 1"
        },
        {
            "id": "tinv_zero_degrees_of_freedom",
            "input": "tinv(0.975, 0)",
            "expectError": true,
            "expectedErrorType": "DomainException",
            "expectedErrorMessage": "Degrees of freedom",
            "notes": "Student's t needs at least some degrees of freedom"
        }
    ]
}
